# P3-009 Skill 沉淀与共享 — SkillLibrary 配置示例
#
# 复制为 skill_library.yaml 后按需修改。
# 所有路径支持相对路径（相对于 flowforge/ 项目根）或绝对路径。
# 也可通过环境变量注入路径（铁律5：禁止硬编码路径）。

# ── SkillLibrary 本地存储 ─────────────────────────────────────────
# 每个技能以 {skill_id}.yaml 持久化到该目录，便于版本控制
skill_library:
  storage_dir: data/skill_library      # 默认：flowforge/data/skill_library
  # 启用后将通过 metrics_collector 上报以下指标：
  #   flowforge_skill_invocations_total{skill_id, invoked_by}
  #   flowforge_skill_invocation_duration_seconds{skill_id, success}
  #   flowforge_skill_library_size
  #   flowforge_skill_registered_total{forgekin_species}
  #   flowforge_skill_updated_total{forgekin_species}
  #   flowforge_skill_evolved_total{forgekin_species}
  metrics_enabled: true

# ── SkillMarket 市场目录 ───────────────────────────────────────────
# 与本地库目录分离，便于权限隔离与审计
skill_market:
  market_dir: data/skill_market        # 默认：flowforge/data/skill_market
  # 发布到市场前的最小成熟度（对应 Capability Maturity Level L0-L4 +1）
  publish_min_maturity: 2              # 默认：2（即 L1+）
  # 评分范围
  rating_min: 1
  rating_max: 5

# ── 进化决策参数 ───────────────────────────────────────────────────
evolution:
  # 最近 N 次调用用于 confidence 平滑更新
  recent_window: 10
  # 置信度平滑系数 α（新 = 旧 * (1 - α) + 最近成功率 * α）
  confidence_smooth_alpha: 0.3
  # 成熟度提升阈值
  maturity_promote_success_rate: 0.9   # success_rate > 该值才提升成熟度
  maturity_promote_usage_min: 10       # usage_count > 该值才提升成熟度
  maturity_max: 5
  maturity_min: 1

# ── 示例 Skill 定义（供参考，可被 SkillLibrary.import_skill 导入）──
example_skills:

  # 示例 1：代码审查技能（猫头鹰·鲁班 物种）
  - skill_id: skill_code_review_demo
    name: 代码审查
    description: |
      对代码差异进行结构化审查，覆盖正确性、安全性、可读性、
      最佳实践四个维度，输出可执行的修复建议。
    forgekin_species: luban
    version: "1.2.0"
    maturity_level: 3                   # L2 - 已沉淀
    trigger_patterns:
      - "\\b代码审查\\b|code review|PR review"
      - "审查.*代码"
      - "review this pr"
    procedure: |
      1. 读取 git diff 并解析变更文件清单
      2. 按文件类型路由到对应语言审查器
      3. 对每个文件按四维度生成 findings
      4. 汇总为优先级排序的修复建议
    preconditions:
      - "diff=provided"                 # 上下文必须包含 diff 字段且值为 provided
      - "repo_root"
    postconditions:
      - "findings_count >= 1"
      - "severity_levels = [info, warning, error, critical]"
    anti_patterns:
      - "只看退出码不检查输出质量"
      - "对自动生成的代码重复审查"
    inputs:
      - diff
      - repo_root
      - language
    outputs:
      - findings
      - summary
    confidence: 0.82
    created_by: forgemind:luban_001
    tags: [code-review, quality, linting]
    is_public: true
    metadata:
      supported_languages: [python, typescript, go, rust]

  # 示例 2：技术文档生成技能（猫头鹰·鲁班 物种）
  - skill_id: skill_doc_gen_demo
    name: 技术文档生成
    description: |
      基于代码结构与签名生成 API 参考文档、模块说明与示例代码。
    forgekin_species: luban
    version: "1.0.0"
    maturity_level: 2                   # L1 - 已规范化
    trigger_patterns:
      - "生成.*文档|generate.*docs?"
      - "\\bAPI 文档\\b"
    procedure: |
      1. 扫描目标目录的 docstring 与签名
      2. 按模块/类/函数组织文档骨架
      3. 对每个公开 API 补充示例
      4. 生成 Markdown 输出
    preconditions:
      - "source_dir"
    inputs:
      - source_dir
      - output_format
    outputs:
      - markdown
      - toc
    confidence: 0.7
    created_by: forgemind:luban_001
    tags: [documentation, markdown, api-docs]
    is_public: true
    metadata: {}

  # 示例 3：性能分析技能（神探·夏洛克 物种）
  - skill_id: skill_perf_analysis_demo
    name: 性能瓶颈分析
    description: |
      通过采样 profile 数据定位热点函数，给出可执行的优化建议。
    forgekin_species: sherlock
    version: "0.9.0"
    maturity_level: 1                   # L0 - 试用
    trigger_patterns:
      - "性能.*分析|profile|perf bottleneck"
      - "为什么.*慢|why is .* slow"
    procedure: |
      1. 加载 profile 数据（py-spy / cProfile / chrome trace）
      2. 计算自顶向下与自底向上火焰图
      3. 识别 top-N 热点函数
      4. 给出优化建议（缓存/向量化/算法替换）
    preconditions:
      - "profile_data"
    anti_patterns:
      - "未实际采样即给出猜测"
    inputs:
      - profile_data
      - top_n
    outputs:
      - hotspots
      - suggestions
    confidence: 0.6
    created_by: forgemind:sherlock_002
    tags: [performance, profiling, optimization]
    is_public: true
    metadata:
      supported_formats: [py-spy, cprofile, chrome-trace]
