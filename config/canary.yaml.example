# FlowForge 金丝雀发布配置示例（P3-008）
#
# 本文件包含 2 个 *Forge 项目部署示例（contentforge-publish / devforge-deploy），
# 每个示例使用 YAML 多文档（`---`）分隔。
#
# 实际使用时，请将每个文档拆分到独立文件并放入 `config/canary/` 目录，
# 由 CanaryDeploymentRegistry.load_from_dir 自动加载（每个文件一个部署）。
# 文件名建议与 `name` 字段一致，例如：
#   config/canary/contentforge-publish.yaml
#   config/canary/devforge-deploy.yaml
#
# *Forge 业务项目（ContentForge / DevForge / NovelForge / MallForge 等）的金丝雀
# 部署配置由各自项目维护，通过 Plugin V3 协议在运行时注入到 CanaryDeploymentRegistry。
#
# 字段说明：
#   name                          部署名（必填，唯一标识）
#   description                   部署描述
#   enabled                       是否启用
#   auto_rollback                 健康检查失败时是否自动回滚
#   rollback_on_error_rate        触发回滚的错误率阈值（保留参考）
#   rollback_on_latency_multiplier 触发回滚的延迟倍率阈值（保留参考）
#   health_check_interval_seconds 健康检查间隔（秒）
#   health_check_timeout_seconds  健康检查超时（秒）
#   observation_seconds           每阶段观测时长（秒）；测试中可置 0 跳过等待
#   metadata                      任意业务元数据
#   stages                        阶段列表，按顺序执行
#     - percentage                  本阶段流量百分比（0-100）
#     - duration_seconds            本阶段持续时长（秒）
#     - health_check_url            健康检查 URL（HTTP GET，期望 200）
#     - success_threshold           成功率阈值（保留参考）
#     - error_rate_threshold        错误率阈值（健康检查通过条件之一）
#     - latency_p99_threshold_ms    P99 延迟阈值（毫秒，健康检查通过条件之一）

# ── 部署示例 1：通用发布场景 ────────────────────────────────────────
---
name: contentforge-publish
description: "ContentForge 发布金丝雀部署示例 — 10%→50%→100% 三阶段渐进发布"
enabled: true
auto_rollback: true
rollback_on_error_rate: 0.05
rollback_on_latency_multiplier: 2.0
health_check_interval_seconds: 30
health_check_timeout_seconds: 10
observation_seconds: 300
metadata:
  project: sample
  scenario: publish
  owner: sample-team
stages:
  - percentage: 10
    duration_seconds: 300
    health_check_url: "http://localhost:8000/healthz"
    success_threshold: 0.99
    error_rate_threshold: 0.01
    latency_p99_threshold_ms: 2000
  - percentage: 50
    duration_seconds: 300
    health_check_url: "http://localhost:8000/healthz"
    success_threshold: 0.99
    error_rate_threshold: 0.02
    latency_p99_threshold_ms: 2500
  - percentage: 100
    duration_seconds: 0
    health_check_url: "http://localhost:8000/healthz"
    success_threshold: 0.99
    error_rate_threshold: 0.05
    latency_p99_threshold_ms: 3000

# ── 部署示例 2：通用部署场景 ───────────────────────────────────────
---
name: devforge-deploy
description: "DevForge 部署金丝雀示例 — 10%→50%→100% 三阶段渐进发布"
enabled: true
auto_rollback: true
rollback_on_error_rate: 0.03
rollback_on_latency_multiplier: 1.8
health_check_interval_seconds: 30
health_check_timeout_seconds: 10
observation_seconds: 180
metadata:
  project: sample
  scenario: deploy
  owner: sample-team
stages:
  - percentage: 10
    duration_seconds: 180
    health_check_url: "http://localhost:8000/api/health"
    success_threshold: 0.995
    error_rate_threshold: 0.005
    latency_p99_threshold_ms: 1500
  - percentage: 50
    duration_seconds: 180
    health_check_url: "http://localhost:8000/api/health"
    success_threshold: 0.99
    error_rate_threshold: 0.01
    latency_p99_threshold_ms: 2000
  - percentage: 100
    duration_seconds: 0
    health_check_url: "http://localhost:8000/api/health"
    success_threshold: 0.99
    error_rate_threshold: 0.02
    latency_p99_threshold_ms: 2500
