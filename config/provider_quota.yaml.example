# ==================== Provider 配额治理配置示例 ====================
# P3-004: 多维度配额检查 + backup 模型自动切换
#
# 此文件为示例配置，复制为 provider_quota.yaml 后由
# ProviderQuotaManager 加载使用。所有字段均可省略，省略后默认不限制。
#
# 字段说明：
#   provider            : Provider 名称（必须与 models.yaml 中 providers 键一致）
#   daily_token_limit   : 每日 Token 总限额（0 表示无限）
#   daily_request_limit : 每日请求次数限额（0 表示无限）
#   rpm_limit           : 每分钟请求次数限额 Requests Per Minute（0 表示无限）
#   tpm_limit           : 每分钟 Token 限额 Tokens Per Minute（0 表示无限）
#   concurrent_limit    : 并发请求限额（0 表示无限）
#   enabled             : 是否启用配额治理（默认 true）
#   backup_models       : 备用模型列表（按优先级排序，主 Provider 失败时按序尝试）
#   cooldown_seconds    : 触发限流后的冷却时间（秒，默认 60）
#   metadata            : 扩展元数据（任意键值对）

providers:
  # ---------- openroute 配额示例 ----------
  # openroute 为聚合网关，每日 Token 限额 100 万、RPM 60
  # backup_models 配置为 doubao-pro 与 glm-4，主模型失败时按序回退
  openroute:
    provider: openroute
    daily_token_limit: 1000000
    daily_request_limit: 10000
    rpm_limit: 60
    tpm_limit: 200000
    concurrent_limit: 10
    enabled: true
    backup_models:
      - doubao-pro
      - glm-4
    cooldown_seconds: 60
    metadata:
      description: "OpenRoute 聚合网关"
      failover_policy: "auto"

  # ---------- doubao 配额示例 ----------
  # 豆包直连，每日 Token 限额 200 万，无 RPM 限制
  # backup_models 配置为 glm-4 与 kimi-k2
  doubao:
    provider: doubao
    daily_token_limit: 2000000
    daily_request_limit: 0
    rpm_limit: 0
    tpm_limit: 0
    concurrent_limit: 5
    enabled: true
    backup_models:
      - glm-4
      - kimi-k2
    cooldown_seconds: 90
    metadata:
      description: "火山引擎豆包大模型"
      region: "cn-beijing"

  # ---------- openai 配额示例 ----------
  # OpenAI 官方，每日 50 万 Token，RPM 50
  openai:
    provider: openai
    daily_token_limit: 500000
    daily_request_limit: 5000
    rpm_limit: 50
    tpm_limit: 150000
    concurrent_limit: 8
    enabled: true
    backup_models:
      - anthropic-claude-3-5
    cooldown_seconds: 30

  # ---------- anthropic 配额示例 ----------
  anthropic:
    provider: anthropic
    daily_token_limit: 800000
    daily_request_limit: 0
    rpm_limit: 0
    tpm_limit: 0
    concurrent_limit: 0
    enabled: true
    backup_models: []
    cooldown_seconds: 60
