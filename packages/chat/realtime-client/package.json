{
  "name": "@flowforge/chat-realtime-client",
  "description": "Socket.IO client transport adapter for @flowforge/chat-realtime (browser runtime)",
  "version": "0.1.0-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/chat/realtime-client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./transport": {
      "types": "./lib/types/transport.d.ts",
      "default": "./lib/transport.js"
    },
    "./events": {
      "types": "./lib/types/events.d.ts",
      "default": "./lib/events.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@flowforge/chat-realtime": "workspace:^"
  },
  "peerDependencies": {
    "socket.io-client": "^4.7.0"
  },
  "devDependencies": {
    "@flowforge/cordis": "workspace:^"
  }
}
