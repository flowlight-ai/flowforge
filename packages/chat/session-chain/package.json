{
  "name": "@flowforge/chat-session-chain",
  "description": "FlowForge chat session-chain/handoff Cordis plugin — F24 session chain management, F225 cat-initiated session handoff (commit-point), F33 session-strategy config + session hooks at ctx.chatSessionChain / ctx.chatSessionHandoff / ctx.chatSessionStrategy / ctx.chatSessionHooks",
  "version": "0.1.0-rc.1",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://gitee.com/flowlight-ai/flowforge.git", "directory": "packages/chat/session-chain" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/types/invariant.d.ts", "default": "./lib/invariant.js" },
    "./session-chain-service": { "types": "./lib/types/session-chain-service.d.ts", "default": "./lib/session-chain-service.js" },
    "./session-handoff-service": { "types": "./lib/types/session-handoff-service.d.ts", "default": "./lib/session-handoff-service.js" },
    "./session-strategy-service": { "types": "./lib/types/session-strategy-service.d.ts", "default": "./lib/session-strategy-service.js" },
    "./session-hooks-service": { "types": "./lib/types/session-hooks-service.d.ts", "default": "./lib/session-hooks-service.js" },
    "./service": { "types": "./lib/types/session-handoff-service.d.ts", "default": "./lib/session-handoff-service.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [ "lib/**/*.js", "lib/**/*.d.ts" ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/cats-shared": "workspace:^",
    "@flowforge/cats-stores": "workspace:^",
    "@flowforge/cats-session": "workspace:^",
    "@flowforge/chat-approval": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/cats-shared": "workspace:^",
    "@flowforge/cats-stores": "workspace:^",
    "@flowforge/cats-session": "workspace:^",
    "@flowforge/chat-approval": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  }
}