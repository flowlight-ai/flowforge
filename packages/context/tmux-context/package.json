{
  "name": "@flowforge/tmux-context",
  "description": "Opt-in durable per-step context with this agent's tmux pane and window location",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/context/tmux-context"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@flowforge/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@flowforge/agent": "workspace:^",
    "@flowforge/shell": "workspace:^",
    "@flowforge/invariants": "workspace:^",
    "@flowforge/session": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/agent": "workspace:^",
    "@flowforge/shell": "workspace:^",
    "@flowforge/invariants": "workspace:^",
    "@flowforge/llm": "workspace:^",
    "@flowforge/session": "workspace:^",
    "@flowforge/system-prompt": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  }
}
