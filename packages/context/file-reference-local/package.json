{
  "name": "@flowforge/context-file-reference-local",
  "description": "FlowForge local-filesystem ctx.fileReferences implementation (dsh port, D39): WorkspaceFileSearch cancellable fuzzy index (directory-scoped live listing + bounded global traversal with background refresh, excluded directories, fuzzy ranking), LocalFileReferenceService with injectable per-agent cwd resolver",
  "version": "0.1.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/context/file-reference-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./search": {
      "types": "./lib/types/search.d.ts",
      "default": "./lib/search.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/cordis": "workspace:^",
    "@flowforge/context-file-reference": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/cordis": "workspace:^",
    "@flowforge/context-file-reference": "workspace:^"
  }
}
