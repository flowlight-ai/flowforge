{
  "name": "@flowforge/http-proxy",
  "description": "Zero-dependency outbound HTTP proxy policy for FlowForge: resolve it from the launch environment and publish it through the proxy environment (Node-native proxy support)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/util/http-proxy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./policy": {
      "types": "./lib/types/policy.d.ts",
      "default": "./lib/policy.js"
    },
    "./install": {
      "types": "./lib/types/install.d.ts",
      "default": "./lib/install.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/policy.js",
    "lib/install.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT"
}