{
  "name": "@flowforge/hooks-codex",
  "description": "Bridge plugin: run a Codex hooks.json hook config on the FlowForge interception seams",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/hooks/hooks-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@flowforge/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@flowforge/agent": "workspace:^",
    "@flowforge/hook-protocol": "workspace:^",
    "@flowforge/invariants": "workspace:^",
    "@flowforge/llm": "workspace:^",
    "@flowforge/session": "workspace:^",
    "@flowforge/session-persistence": "workspace:^",
    "@flowforge/tools": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/agent": "workspace:^",
    "@flowforge/agent-loop": "workspace:^",
    "@flowforge/agent-loop-testkit": "workspace:^",
    "@flowforge/shell": "workspace:^",
    "@flowforge/bash-local": "workspace:^",
    "@flowforge/subprocess-local": "workspace:^",
    "@flowforge/hook-protocol": "workspace:^",
    "@flowforge/invariants": "workspace:^",
    "@flowforge/llm": "workspace:^",
    "@flowforge/session": "workspace:^",
    "@flowforge/session-persistence": "workspace:^",
    "@flowforge/session-persistence-jsonl": "workspace:^",
    "@flowforge/tools": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  }
}
