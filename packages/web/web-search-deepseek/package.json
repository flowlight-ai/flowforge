{
  "name": "@flowforge/web-search-deepseek",
  "description": "DeepSeek-backed search provider (native web_search via the Anthropic-compatible API) for the FlowForge web capability seam (ctx.web)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/web/web-search-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/agent": "workspace:^",
    "@flowforge/credentials": "workspace:^",
    "@flowforge/launch-environment": "workspace:^",
    "@flowforge/invariants": "workspace:^",
    "@flowforge/session": "workspace:^",
    "@flowforge/web": "workspace:^",
    "@flowforge/cordis": "workspace:^",
    "@flowforge/settings": "workspace:^"
  },
  "dependencies": {
    "@flowforge/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/agent": "workspace:^",
    "@flowforge/credentials": "workspace:^",
    "@flowforge/credentials-local": "workspace:^",
    "@flowforge/launch-environment": "workspace:^",
    "@flowforge/invariants": "workspace:^",
    "@flowforge/session": "workspace:^",
    "@flowforge/web": "workspace:^",
    "@flowforge/cordis": "workspace:^",
    "@flowforge/settings": "workspace:^"
  }
}
