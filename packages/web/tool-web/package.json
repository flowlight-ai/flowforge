{
  "name": "@flowforge/tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the FlowForge web capability seam (ctx.web)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/invariants": "workspace:^",
    "@flowforge/llm": "workspace:^",
    "@flowforge/system-prompt": "workspace:^",
    "@flowforge/tools": "workspace:^",
    "@flowforge/web": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "@flowforge/schemastery": "workspace:^",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@flowforge/agent": "workspace:^",
    "@types/turndown": "^5.0.6",
    "@flowforge/invariants": "workspace:^",
    "@flowforge/llm": "workspace:^",
    "@flowforge/session": "workspace:^",
    "@flowforge/spill-local": "workspace:^",
    "@flowforge/spill-policy": "workspace:^",
    "@flowforge/system-prompt": "workspace:^",
    "@flowforge/tool-call-timeout-policy": "workspace:^",
    "@flowforge/tools": "workspace:^",
    "@flowforge/web": "workspace:^",
    "@flowforge/web-fetch-http": "workspace:^",
    "@flowforge/web-search-exa": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  }
}
