{
  "name": "@flowforge/tool-lsp",
  "description": "Model-facing lsp tool over the FlowForge LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/invariants": "workspace:^",
    "@flowforge/llm": "workspace:^",
    "@flowforge/lsp": "workspace:^",
    "@flowforge/system-prompt": "workspace:^",
    "@flowforge/timeout": "workspace:^",
    "@flowforge/tools": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  },
  "dependencies": {
    "@flowforge/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/agent": "workspace:^",
    "@flowforge/fs-local": "workspace:^",
    "@flowforge/invariants": "workspace:^",
    "@flowforge/llm": "workspace:^",
    "@flowforge/lsp": "workspace:^",
    "@flowforge/lsp-stdio": "workspace:^",
    "@flowforge/session": "workspace:^",
    "@flowforge/subprocess-local": "workspace:^",
    "@flowforge/system-prompt": "workspace:^",
    "@flowforge/timeout": "workspace:^",
    "@flowforge/tool-call-timeout-policy": "workspace:^",
    "@flowforge/tools": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  }
}
