{
  "name": "@flowforge/tool-pwsh",
  "description": "Model-facing pwsh tool over the bash executor seam",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/shell/tool-pwsh"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/agent": "workspace:^",
    "@flowforge/shell": "workspace:^",
    "@flowforge/shell-env": "workspace:^",
    "@flowforge/invariants": "workspace:^",
    "@flowforge/llm": "workspace:^",
    "@flowforge/sandbox": "workspace:^",
    "@flowforge/sandbox-policy": "workspace:^",
    "@flowforge/system-prompt": "workspace:^",
    "@flowforge/jobs": "workspace:^",
    "@flowforge/tools": "workspace:^",
    "@flowforge/user-approval": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  },
  "dependencies": {
    "@flowforge/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/agent": "workspace:^",
    "@flowforge/shell": "workspace:^",
    "@flowforge/shell-env": "workspace:^",
    "@flowforge/invariants": "workspace:^",
    "@flowforge/llm": "workspace:^",
    "@flowforge/loader-smoke": "workspace:^",
    "@flowforge/pwsh-local": "workspace:^",
    "@flowforge/sandbox": "workspace:^",
    "@flowforge/sandbox-policy": "workspace:^",
    "@flowforge/subprocess-local": "workspace:^",
    "@flowforge/system-prompt": "workspace:^",
    "@flowforge/jobs": "workspace:^",
    "@flowforge/jobs-local": "workspace:^",
    "@flowforge/tool-jobs": "workspace:^",
    "@flowforge/tools": "workspace:^",
    "@flowforge/user-approval": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  }
}
