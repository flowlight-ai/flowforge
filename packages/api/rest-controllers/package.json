{
  "name": "@flowforge/api-rest-controllers",
  "description": "FlowForge REST controllers family (session/settings/workspace) — self-contained, framework-agnostic handler seam with injectable store/auth/fs/git ports + in-memory contract implementations. Ported from clowder-ai `packages/api/src/routes` (A1-A3). EP2 wires the host HTTP framework/auth/store.",
  "version": "0.1.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/api/rest-controllers"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./ports": {
      "types": "./lib/types/ports/index.d.ts",
      "default": "./lib/ports/index.js"
    },
    "./contract": {
      "types": "./lib/types/contract/index.d.ts",
      "default": "./lib/contract/index.js"
    },
    "./controllers": {
      "types": "./lib/types/controllers/index.d.ts",
      "default": "./lib/controllers/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "zod": "^4.4.3"
  }
}