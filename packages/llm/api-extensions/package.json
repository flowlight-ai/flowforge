{
  "name": "@flowforge/llm-api-extensions",
  "description": "Additive top-level request-field registry for provider DeepSeek LLM API adapters",
  "version": "0.1.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/llm/api-extensions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/cordis": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/cordis": "workspace:^"
  }
}