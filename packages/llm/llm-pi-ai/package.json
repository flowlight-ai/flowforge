{
  "name": "@flowforge/llm-pi-ai",
  "description": "pi-ai-backed DeepSeek adapter for the FlowForge LLM seam (design-verification twin of flowforge-llm-deepseek)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/llm/llm-pi-ai"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/attachment": "workspace:^",
    "@flowforge/credentials": "workspace:^",
    "@flowforge/launch-environment": "workspace:^",
    "@flowforge/invariants": "workspace:^",
    "@flowforge/llm": "workspace:^",
    "@flowforge/settings": "workspace:^",
    "@flowforge/timeout": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.82.1",
    "@flowforge/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/attachment": "workspace:^",
    "@flowforge/credentials": "workspace:^",
    "@flowforge/launch-environment": "workspace:^",
    "@flowforge/invariants": "workspace:^",
    "@flowforge/llm": "workspace:^",
    "@flowforge/llm-deepseek": "workspace:^",
    "@flowforge/settings": "workspace:^",
    "@flowforge/timeout": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  }
}
