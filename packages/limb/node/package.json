{
  "name": "@flowforge/limb-node",
  "description": "FlowForge limb node domain Cordis plugin — T6.2 RemoteLimbNode + PluginLimbAdapter + PluginRestExecutor + PluginTokenManager at ctx.limbNodes",
  "version": "0.1.0-rc.1",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://gitee.com/flowlight-ai/flowforge.git", "directory": "packages/limb/node" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./remote-limb-node": { "types": "./lib/types/remote-limb-node.d.ts", "default": "./lib/remote-limb-node.js" },
    "./plugin-limb-adapter": { "types": "./lib/types/plugin-limb-adapter.d.ts", "default": "./lib/plugin-limb-adapter.js" },
    "./plugin-rest-executor": { "types": "./lib/types/plugin-rest-executor.d.ts", "default": "./lib/plugin-rest-executor.js" },
    "./plugin-token-manager": { "types": "./lib/types/plugin-token-manager.d.ts", "default": "./lib/plugin-token-manager.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [ "lib/**/*.js", "lib/**/*.d.ts" ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/cordis": "workspace:^",
    "@flowforge/limb-core": "workspace:^",
    "@flowforge/limb-embodiment": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/cordis": "workspace:^",
    "@flowforge/limb-core": "workspace:^",
    "@flowforge/limb-embodiment": "workspace:^"
  }
}
