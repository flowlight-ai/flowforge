{
  "name": "@flowforge/tool-session-query",
  "description": "Workspace-authorized model-facing session history search, trace, and event read tools",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/session-query/tool-session-query"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/invariants": "workspace:^",
    "@flowforge/llm": "workspace:^",
    "@flowforge/session": "workspace:^",
    "@flowforge/session-query": "workspace:^",
    "@flowforge/system-prompt": "workspace:^",
    "@flowforge/timeout": "workspace:^",
    "@flowforge/tools": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  },
  "dependencies": {
    "@flowforge/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/agent": "workspace:^",
    "@flowforge/invariants": "workspace:^",
    "@flowforge/llm": "workspace:^",
    "@flowforge/session": "workspace:^",
    "@flowforge/session-persistence": "workspace:^",
    "@flowforge/session-persistence-jsonl": "workspace:^",
    "@flowforge/session-query": "workspace:^",
    "@flowforge/session-query-sqlite": "workspace:^",
    "@flowforge/session-title": "workspace:^",
    "@flowforge/system-prompt": "workspace:^",
    "@flowforge/timeout": "workspace:^",
    "@flowforge/tool-call-timeout-policy": "workspace:^",
    "@flowforge/tools": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  }
}
