{
  "name": "@flowforge/cats-stores",
  "description": "Forgekin (cats) store ports + Memory backend Cordis plugin + CatStores aggregate service",
  "version": "0.1.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/cats/stores"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./ports": {
      "types": "./lib/types/ports/index.d.ts",
      "default": "./lib/ports/index.js"
    },
    "./memory": {
      "types": "./lib/types/memory/index.d.ts",
      "default": "./lib/memory/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/ports/**/*.js",
    "lib/memory/**/*.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/cats-shared": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/cats-shared": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  }
}
