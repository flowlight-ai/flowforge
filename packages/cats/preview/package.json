{
  "name": "@flowforge/cats-preview",
  "description": "FlowForge preview Cordis plugin - C28 Preview (F120/F156), TS rewrite of clowder-ai domains/preview: loopback-only reverse proxy gateway with port whitelist (DEFAULT_EXCLUDED_PORTS + runtime env merge) + Origin validation + iframe-header stripping + bridge/WS-patch injection, stdout port discovery with reachability probe, http-proxy stripped to injectable PreviewProxyServer port at ctx.catsPreview",
  "version": "0.1.0-rc.1",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://gitee.com/flowlight-ai/flowforge.git", "directory": "packages/cats/preview" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./types": { "types": "./lib/types/types.d.ts", "default": "./lib/types.js" },
    "./port-validator": { "types": "./lib/types/port-validator.d.ts", "default": "./lib/port-validator.js" },
    "./port-discovery": { "types": "./lib/types/port-discovery.d.ts", "default": "./lib/port-discovery.js" },
    "./bridge-script": { "types": "./lib/types/bridge-script.d.ts", "default": "./lib/bridge-script.js" },
    "./ws-patch-script": { "types": "./lib/types/ws-patch-script.d.ts", "default": "./lib/ws-patch-script.js" },
    "./origin": { "types": "./lib/types/origin.d.ts", "default": "./lib/origin.js" },
    "./preview-gateway": { "types": "./lib/types/preview-gateway.d.ts", "default": "./lib/preview-gateway.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [ "lib/**/*.js", "lib/**/*.d.ts" ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/cordis": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/cordis": "workspace:^"
  }
}
