{
  "name": "@flowforge/cats-human-disposition",
  "description": "FlowForge human disposition Cordis plugin - C28 HumanDisposition (F281), TS rewrite of clowder-ai domains/human-disposition: zod-verified ledger entries (episode+envelope), receipt index (sourceRef-keyed), dual-index zset ledger with strict cursor pagination, opaque proof minting for person-memory proposals, session-handoff/wait-cancel disposition adapters, lexical candidate extraction + exact-subject feedback context projection at ctx.catsHumanDisposition",
  "version": "0.1.0-rc.1",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://gitee.com/flowlight-ai/flowforge.git", "directory": "packages/cats/human-disposition" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./types": { "types": "./lib/types/types.d.ts", "default": "./lib/types.js" },
    "./keys": { "types": "./lib/types/keys.d.ts", "default": "./lib/keys.js" },
    "./lexical-noise": { "types": "./lib/types/lexical-noise.d.ts", "default": "./lib/lexical-noise.js" },
    "./ledger": { "types": "./lib/types/ledger.d.ts", "default": "./lib/ledger.js" },
    "./lua": { "types": "./lib/types/lua.d.ts", "default": "./lib/lua.js" },
    "./adapters": { "types": "./lib/types/adapters.d.ts", "default": "./lib/adapters.js" },
    "./receipt-index": { "types": "./lib/types/receipt-index.d.ts", "default": "./lib/receipt-index.js" },
    "./context-service": { "types": "./lib/types/context-service.d.ts", "default": "./lib/context-service.js" },
    "./wait-cancel-types": { "types": "./lib/types/wait-cancel-types.d.ts", "default": "./lib/wait-cancel-types.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [ "lib/**/*.js", "lib/**/*.d.ts" ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/cordis": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@flowforge/cordis": "workspace:^",
    "zod": "^4.4.3"
  }
}
