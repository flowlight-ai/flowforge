{
  "name": "@flowforge/cats-games",
  "description": "Game command interceptor + budget/seat-building pure layer (S5 stretch). Ports clowder-ai game-command-interceptor (parseGameCommand/sanitizeCatIds/buildGameSeats) plus zod start-schemas, free of LLM/transport dependencies so the decision surface is unit-testable in isolation before the Werewolf engine lands (S5-2).",
  "version": "0.1.0-rc.1",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://gitee.com/flowlight-ai/flowforge.git", "directory": "packages/cats/games" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./schema": { "types": "./lib/types/schema.d.ts", "default": "./lib/schema.js" },
    "./command-interceptor": { "types": "./lib/types/command-interceptor.d.ts", "default": "./lib/command-interceptor.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [ "lib/**/*.js", "lib/**/*.d.ts" ],
  "license": "MIT",
  "dependencies": {
    "@flowforge/cats-shared": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@flowforge/cats-shared": "workspace:^"
  }
}