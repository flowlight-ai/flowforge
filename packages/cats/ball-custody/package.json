  "version": "0.1.0-rc.1",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://gitee.com/flowlight-ai/flowforge.git", "directory": "packages/cats/ball-custody" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./models": { "types": "./lib/types/models.d.ts", "default": "./lib/models.js" },
    "./registry": { "types": "./lib/types/registry.d.ts", "default": "./lib/registry.js" },
    "./push-back": { "types": "./lib/types/push-back.d.ts", "default": "./lib/push-back.js" },
    "./state-machine": { "types": "./lib/types/state-machine.d.ts", "default": "./lib/state-machine.js" },
    "./projector": { "types": "./lib/types/projector.d.ts", "default": "./lib/projector.js" },
    "./config": { "types": "./lib/types/config.d.ts", "default": "./lib/config.js" },
    "./config/ball-custody.yaml": "./config/ball-custody.yaml",
    "./src/*": "./src/*",
