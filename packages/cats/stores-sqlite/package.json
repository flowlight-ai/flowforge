{
  "name": "@flowforge/cats-stores-sqlite",
  "description": "SQLite durable stores backend for Forgekin (cats) — 9 store tables + transactional CAS replacing Redis Lua",
  "version": "0.1.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/cats/stores-sqlite"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/sqlite/**/*.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/cats-shared": "workspace:^",
    "@flowforge/cats-stores": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  },
  "dependencies": {
    "@flowforge/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/cats-shared": "workspace:^",
    "@flowforge/cats-stores": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  }
}
