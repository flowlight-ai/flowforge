{
  "name": "@flowforge/cats-signal-intake",
  "description": "FlowForge signal-intake domain — SignalAdmission (signal admission), Meeting Intake family (stores/codec/services/artifact delivery), ASR person-memory scene, Source Access Lease, ThreadDestinationAuthority and LarkCli Feishu source resolver. Ported from clowder-ai `domains/signal-intake` (B3 / C46). Self-contained: external storage/delivery/credential seams are injectable ports with in-memory contract implementations.",
  "version": "0.1.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/cats/signal-intake"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./contract/signals": {
      "types": "./lib/types/contract/signals.d.ts",
      "default": "./lib/contract/signals.js"
    },
    "./contract/events-publish": {
      "types": "./lib/types/contract/events-publish.d.ts",
      "default": "./lib/contract/events-publish.js"
    },
    "./contract/asr-person-memory-scene": {
      "types": "./lib/types/contract/asr-person-memory-scene.d.ts",
      "default": "./lib/contract/asr-person-memory-scene.js"
    },
    "./redis": {
      "types": "./lib/types/redis/index.d.ts",
      "default": "./lib/redis/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/cats-shared": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@flowforge/cats-shared": "workspace:^",
    "zod": "^4.4.3"
  }
}