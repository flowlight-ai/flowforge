{
  "name": "@flowforge/cats-invocation",
  "description": "Forgekin (cats) invocation queue / tracker / mutex / progress Cordis service seam — abstract contracts mounted at ctx.catsInvocation",
  "version": "0.1.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/cats/invocation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./queue": {
      "types": "./lib/types/queue.d.ts",
      "default": "./lib/queue.js"
    },
    "./tracker": {
      "types": "./lib/types/tracker.d.ts",
      "default": "./lib/tracker.js"
    },
    "./mutex": {
      "types": "./lib/types/mutex.d.ts",
      "default": "./lib/mutex.js"
    },
    "./progress": {
      "types": "./lib/types/progress.d.ts",
      "default": "./lib/progress.js"
    },
    "./processor": {
      "types": "./lib/types/processor.d.ts",
      "default": "./lib/processor.js"
    },
    "./reconcile": {
      "types": "./lib/types/reconcile.d.ts",
      "default": "./lib/reconcile.js"
    },
    "./startup-reconciler": {
      "types": "./lib/types/startup-reconciler.d.ts",
      "default": "./lib/startup-reconciler.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/queue.js",
    "lib/tracker.js",
    "lib/mutex.js",
    "lib/progress.js",
    "lib/processor.js",
    "lib/reconcile.js",
    "lib/startup-reconciler.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/cats-shared": "workspace:^",
    "@flowforge/cats-stores": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/cats-shared": "workspace:^",
    "@flowforge/cats-stores": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  }
}
