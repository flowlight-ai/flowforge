    "./pack-security-guard": { "types": "./lib/types/pack-security-guard.d.ts", "default": "./lib/pack-security-guard.js" },
    "./pack-compiler": { "types": "./lib/types/pack-compiler.d.ts", "default": "./lib/pack-compiler.js" },
    "./pack-loader": { "types": "./lib/types/pack-loader.d.ts", "default": "./lib/pack-loader.js" },
    "./growth-boundary": { "types": "./lib/types/growth-boundary.d.ts", "default": "./lib/growth-boundary.js" },
    "./pack-exporter": { "types": "./lib/types/pack-exporter.d.ts", "default": "./lib/pack-exporter.js" },
    "./pack-knowledge-scope": { "types": "./lib/types/pack-knowledge-scope.d.ts", "default": "./lib/pack-knowledge-scope.js" },
    "./get-active-pack-blocks": { "types": "./lib/types/get-active-pack-blocks.d.ts", "default": "./lib/get-active-pack-blocks.js" },
    "./src/*": "./src/*",
