{
  "name": "@flowforge/cats-context-assembly",
  "description": "FlowForge context-assembly domain (B12) — Message Bundle selection/projection/carrier resolution, IntentParser, governance L0 compile, prompt template loader, L0 staging content, chat history ContextAssembler and SystemPromptBuilder. Ported from clowder-ai `domains/cats/services/context`. Self-contained: store/config/file/dossier/model/prompt-pipeline seams are injectable ports with in-memory contract implementations.",
  "version": "0.1.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/cats/context-assembly"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./message-bundle": {
      "types": "./lib/types/message-bundle/index.d.ts",
      "default": "./lib/message-bundle/index.js"
    },
    "./context": {
      "types": "./lib/types/context/index.d.ts",
      "default": "./lib/context/index.js"
    },
    "./ports": {
      "types": "./lib/types/ports/index.d.ts",
      "default": "./lib/ports/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/cats-shared": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@flowforge/cats-shared": "workspace:^",
    "zod": "^4.4.3"
  }
}