{
  "name": "@flowforge/plugin-codebase",
  "description": "Codebase intelligence plugin for FlowForge: tree-sitter knowledge graph, node:sqlite storage with FTS5 BM25 search, structural indexing and query surface — ported from codebase-memory-mcp (EP-CB), foundation for plugin-dev code indexing and repository-wide fast retrieval",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/plugins/codebase"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "ff_codebase": "bin/ff_codebase.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.25.8"
  }
}
