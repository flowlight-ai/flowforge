{
  "name": "@flowforge/plugins-github",
  "description": "FlowForge GitHub upstream reference plugin (C35, clowder port): plugin.yaml assembly declaration ported to typed manifest (config envs GITHUB_TOKEN/GITHUB_SETUP_NOISE_BOT_LOGINS/GITHUB_MCP_PAT) + 7 schedule factory declarations wired to @flowforge/infrastructure-email task specs where ported, with env resolution/validation and privacy-safe summary",
  "version": "0.1.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/plugins/github"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./manifest": {
      "types": "./lib/types/manifest.d.ts",
      "default": "./lib/manifest.js"
    },
    "./config": {
      "types": "./lib/types/config.d.ts",
      "default": "./lib/config.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/cordis": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/cordis": "workspace:^"
  }
}
