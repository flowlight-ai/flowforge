{
  "name": "@flowforge/plugins-weixin-mp",
  "description": "FlowForge WeChat MP plugin (C35 upstream reference plugin, clowder port): markdownToWxHtml converter (inline styles/URL whitelist/HTML escaping) + six invoke handlers (convert_markdown/upload_image/upload_material/create_draft/update_draft/check_status) with injectable deps and path-traversal-guarded tmpdir-only file access, limb-adapter port types",
  "version": "0.1.0-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/plugins/weixin-mp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./markdown-to-wx-html": {
      "types": "./lib/types/markdown-to-wx-html.d.ts",
      "default": "./lib/markdown-to-wx-html.js"
    },
    "./handlers": {
      "types": "./lib/types/handlers.d.ts",
      "default": "./lib/handlers.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/cordis": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/cordis": "workspace:^"
  }
}
