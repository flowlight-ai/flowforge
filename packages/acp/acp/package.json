{
  "name": "@flowforge/acp",
  "description": "Automation-only Agent Client Protocol server for driving FlowForge agents over JSON-RPC stdio",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "0.25.1",
    "@flowforge/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@flowforge/agent": "workspace:^",
    "@flowforge/invariants": "workspace:^",
    "@flowforge/session": "workspace:^",
    "@flowforge/user-approval": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/agent": "workspace:^",
    "@flowforge/agent-loop": "workspace:^",
    "@flowforge/agent-loop-testkit": "workspace:^",
    "@flowforge/invariants": "workspace:^",
    "@flowforge/llm": "workspace:^",
    "@flowforge/session": "workspace:^",
    "@flowforge/tools": "workspace:^",
    "@flowforge/user-approval": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  }
}
