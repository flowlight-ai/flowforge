{
  "name": "@flowforge/forgekin-capability",
  "description": "FlowForge Forgekin capability domain Cordis plugin — T7.2 CapabilityProfile six-dimension profile (model/cognitive/blind-spots/skills/tool-boundary/performance) + ProfileAnalyzer gap analysis at ctx.forgeCapability",
  "version": "0.1.0-rc.1",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://gitee.com/flowlight-ai/flowforge.git", "directory": "packages/forgekin/capability" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./models": { "types": "./lib/types/models.d.ts", "default": "./lib/models.js" },
    "./profile": { "types": "./lib/types/profile.d.ts", "default": "./lib/profile.js" },
    "./analyzer": { "types": "./lib/types/analyzer.d.ts", "default": "./lib/analyzer.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [ "lib/**/*.js", "lib/**/*.d.ts" ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/cordis": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/cordis": "workspace:^"
  }
}
