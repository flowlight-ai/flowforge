{
  "name": "@flowforge/forgekin-external-agents",
  "description": "FlowForge Forgekin external agents domain Cordis plugin — T7.9 EAC seven-contract third-party agent adapters (claude_code/codex/gemini/opencode/trae/custom) + HelmEventEmitter LLM bridge, TS rewrite of forgemind/external_agents.py + core/helm_adapter.py at ctx.forgeExternalAgents",
  "version": "0.1.0-rc.1",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://gitee.com/flowlight-ai/flowforge.git", "directory": "packages/forgekin/external-agents" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./external-agent": { "types": "./lib/types/external-agent.d.ts", "default": "./lib/external-agent.js" },
    "./helm-adapter": { "types": "./lib/types/helm-adapter.d.ts", "default": "./lib/helm-adapter.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [ "lib/**/*.js", "lib/**/*.d.ts" ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/cordis": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/cordis": "workspace:^"
  }
