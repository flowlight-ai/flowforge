{
  "name": "@flowforge/forgekin-roles",
  "description": "FlowForge Forgekin roles domain Cordis plugin — T7.28 four special-role sub-agents (ProductManager/DevOps/SecurityOfficer/DeliveryManager, F041-F044) at ctx.forgeRoles, TS rewrite of forgemind/forms.py + species_impl/org.py observe/act/verify contract",
  "version": "0.1.0-rc.1",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://gitee.com/flowlight-ai/flowforge.git", "directory": "packages/forgekin/roles" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
