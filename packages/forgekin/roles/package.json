    "./base": { "types": "./lib/types/base.d.ts", "default": "./lib/base.js" },
    "./product-manager": { "types": "./lib/types/product-manager.d.ts", "default": "./lib/product-manager.js" },
    "./devops": { "types": "./lib/types/devops.d.ts", "default": "./lib/devops.js" },
    "./security-officer": { "types": "./lib/types/security-officer.d.ts", "default": "./lib/security-officer.js" },
    "./delivery-manager": { "types": "./lib/types/delivery-manager.d.ts", "default": "./lib/delivery-manager.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [ "lib/**/*.js", "lib/**/*.d.ts" ],
  "license": "MIT",
  "peerDependencies": {
