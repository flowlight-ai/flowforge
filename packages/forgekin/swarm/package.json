{
  "name": "@flowforge/forgekin-swarm",
  "description": "FlowForge Forgekin Swarm domain Cordis plugin — T7.15 multi-agent swarm orchestration (SwarmCoordinator capability routing + heartbeat timeout reassign + cross-vendor/no-self-review filters + complement agents), TS rewrite of forgemind/swarm.py at ctx.forgeSwarm",
  "version": "0.1.0-rc.1",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://gitee.com/flowlight-ai/flowforge.git", "directory": "packages/forgekin/swarm" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./models": { "types": "./lib/types/models.d.ts", "default": "./lib/models.js" },
    "./coordinator": { "types": "./lib/types/coordinator.d.ts", "default": "./lib/coordinator.js" },
    "./config": { "types": "./lib/types/config.d.ts", "default": "./lib/config.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [ "lib/**/*.js", "lib/**/*.d.ts", "config/**/*.yaml" ],
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.4.0"
  },
  "peerDependencies": {
    "@flowforge/cordis": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/cordis": "workspace:^"
  }
}
