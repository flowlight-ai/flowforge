{
  "name": "@flowforge/forgekin-sop",
  "description": "FlowForge Forgekin SOP domain Cordis plugin — T7.24 Standard Operating Procedure stage-gate engine (SOPDefinition/SOPStage/HardRule/Pitfall + PredicateChecker 8 checkers + SOPExecutor gate/advance), TS rewrite of sop/*.py at ctx.forgeSop",
  "version": "0.1.0-rc.1",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://gitee.com/flowlight-ai/flowforge.git", "directory": "packages/forgekin/sop" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./models": { "types": "./lib/types/models.d.ts", "default": "./lib/models.js" },
    "./predicate": { "types": "./lib/types/predicate.d.ts", "default": "./lib/predicate.js" },
    "./engine": { "types": "./lib/types/engine.d.ts", "default": "./lib/engine.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [ "lib/**/*.js", "lib/**/*.d.ts" ],
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.4.0"
  },
  "peerDependencies": {
    "@flowforge/cordis": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/cordis": "workspace:^"
  }
}
