{
  "name": "@flowforge/forgekin-lineage",
  "description": "FlowForge Forgekin lineage Cordis plugin - F038 LineageRelation/LineageNode/LineageEdge data models + LineageStore (addNode/addEdge/getNode/getAncestry/getDescendants bidirectional traversal) + LineageSplitExecutor/FuseExecutor (split keeps parent bloodline, fuse keeps multi-parent bloodline, operator approval), config-driven forgekin-lineage.yaml, TS rewrite of docs/features/F038 at ctx.forgeLineage",
  "version": "0.1.0-rc.1",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://gitee.com/flowlight-ai/flowforge.git", "directory": "packages/forgekin/lineage" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./models": { "types": "./lib/types/models.d.ts", "default": "./lib/models.js" },
    "./store": { "types": "./lib/types/store.d.ts", "default": "./lib/store.js" },
    "./executors": { "types": "./lib/types/executors.d.ts", "default": "./lib/executors.js" },
    "./config": { "types": "./lib/types/config.d.ts", "default": "./lib/config.js" },
    "./config/forgekin-lineage.yaml": "./config/forgekin-lineage.yaml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [ "lib/**/*.js", "lib/**/*.d.ts", "config/*.yaml" ],
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.4.0"
  },
  "peerDependencies": {
    "@flowforge/cordis": "workspace:^",
    "@flowforge/forgekin-soul": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/cordis": "workspace:^",
    "@flowforge/forgekin-soul": "workspace:^"
  }
}
