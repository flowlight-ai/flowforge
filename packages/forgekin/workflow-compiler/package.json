{
  "name": "@flowforge/forgekin-workflow-compiler",
  "description": "FlowForge Forgekin workflow compiler domain Cordis plugin — T7.8 YAML workflow → execution graph: WorkflowParser/Validator/CodeGen three-stage compiler with conditional routing at ctx.forgeWorkflowCompiler",
  "version": "0.1.0-rc.1",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://gitee.com/flowlight-ai/flowforge.git", "directory": "packages/forgekin/workflow-compiler" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./ir": { "types": "./lib/types/ir.d.ts", "default": "./lib/ir.js" },
    "./errors": { "types": "./lib/types/errors.d.ts", "default": "./lib/errors.js" },
    "./parser": { "types": "./lib/types/parser.d.ts", "default": "./lib/parser.js" },
    "./validator": { "types": "./lib/types/validator.d.ts", "default": "./lib/validator.js" },
    "./codegen": { "types": "./lib/types/codegen.d.ts", "default": "./lib/codegen.js" },
    "./compiler": { "types": "./lib/types/compiler.d.ts", "default": "./lib/compiler.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [ "lib/**/*.js", "lib/**/*.d.ts" ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/cordis": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/cordis": "workspace:^"
  }
}
