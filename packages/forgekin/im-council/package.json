    "./channel": { "types": "./lib/types/channel.d.ts", "default": "./lib/channel.js" },
    "./console-channel": { "types": "./lib/types/console-channel.d.ts", "default": "./lib/console-channel.js" },
    "./webchat-channel": { "types": "./lib/types/webchat-channel.d.ts", "default": "./lib/webchat-channel.js" },
    "./trae-channel": { "types": "./lib/types/trae-channel.d.ts", "default": "./lib/trae-channel.js" },
    "./im-council-manager": { "types": "./lib/types/im-council-manager.d.ts", "default": "./lib/im-council-manager.js" },
    "./service": { "types": "./lib/types/im-council-service.d.ts", "default": "./lib/im-council-service.js" },
    "./src/*": "./src/*",
