{
  "name": "@flowforge/forgekin-memory",
  "description": "FlowForge Forgekin memory domain Cordis plugin — T7.3 EchoStore episodic memory (five EchoStore backends + MemoryManager save/retrieve/hybrid_search/list/get/delete at ctx.forgeMemory)",
  "version": "0.1.0-rc.1",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://gitee.com/flowlight-ai/flowforge.git", "directory": "packages/forgekin/memory" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./echo-store": { "types": "./lib/types/echo-store.d.ts", "default": "./lib/echo-store.js" },
    "./memory-manager": { "types": "./lib/types/memory-manager.d.ts", "default": "./lib/memory-manager.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [ "lib/**/*.js", "lib/**/*.d.ts" ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/cordis": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/cordis": "workspace:^"
  }
}
