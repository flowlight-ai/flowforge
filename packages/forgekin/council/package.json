{
  "name": "@flowforge/forgekin-council",
  "description": "FlowForge Forgekin council domain Cordis plugin — T7.5 MindCouncil cross-vendor review: CouncilVerdict/CouncilSession aggregation with min_reviewers/min_distinct_vendors/pass_threshold enforcement at ctx.forgeCouncil",
  "version": "0.1.0-rc.1",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://gitee.com/flowlight-ai/flowforge.git", "directory": "packages/forgekin/council" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./models": { "types": "./lib/types/models.d.ts", "default": "./lib/models.js" },
    "./council-channel": { "types": "./lib/types/council-channel.d.ts", "default": "./lib/council-channel.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [ "lib/**/*.js", "lib/**/*.d.ts" ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/cordis": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/cordis": "workspace:^"
  }
}
