{
  "name": "@flowforge/forgekin-plugins",
  "description": "FlowForge Forgekin marketplace Cordis plugin — T7.11 插件市场（F11）：PluginManifest 清单 + MarketplaceRegistry 本地/远程注册表（search/list/getPlugin/refresh）+ Marketplace 一键安装/卸载/更新/验证（依赖递归解析/FlowForge 版本兼容/checksum 校验/危险模式安全扫描/installed.json 持久化）+ FrontendPluginRegistry 前端插件六挂载点注册表，TS rewrite of core/marketplace.py + core/plugin_frontend.py at ctx.forgePlugins",
  "version": "0.1.0-rc.1",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://gitee.com/flowlight-ai/flowforge.git", "directory": "packages/forgekin/plugins" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./types": { "types": "./lib/types/types.d.ts", "default": "./lib/types.js" },
    "./registry": { "types": "./lib/types/registry.d.ts", "default": "./lib/registry.js" },
    "./frontend-registry": { "types": "./lib/types/frontend-registry.d.ts", "default": "./lib/frontend-registry.js" },
    "./marketplace": { "types": "./lib/types/marketplace.d.ts", "default": "./lib/marketplace.js" },
    "./service": { "types": "./lib/types/service.d.ts", "default": "./lib/service.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [ "lib/**/*.js", "lib/**/*.d.ts" ],
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.4.0"
  },
  "peerDependencies": {
    "@flowforge/cordis": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/cordis": "workspace:^"
  }
}
