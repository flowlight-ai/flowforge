{
  "name": "@flowforge/base",
  "description": "The shared flowforge core as a profile bundle: every profile's first patch layer, inserting the base plugin rows over the empty profile root",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/bundle/base"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "flowforge": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@flowforge/cordis-plugin-hmr": "workspace:^",
    "@flowforge/cordis-plugin-timer": "workspace:^",
    "@flowforge/agent": "workspace:^",
    "@flowforge/agent-default-model": "workspace:^",
    "@flowforge/agent-loop": "workspace:^",
    "@flowforge/attachment-local": "workspace:^",
    "@flowforge/shell-env": "workspace:^",
    "@flowforge/bash-sandbox": "workspace:^",
    "@flowforge/command-compact": "workspace:^",
    "@flowforge/command-feedback": "workspace:^",
    "@flowforge/command-goal": "workspace:^",
    "@flowforge/commands": "workspace:^",
    "@flowforge/compaction-basic": "workspace:^",
    "@flowforge/compaction-tool-result-pruner": "workspace:^",
    "@flowforge/credentials-local": "workspace:^",
    "@flowforge/fs-local": "workspace:^",
    "@flowforge/fs-observation-policy": "workspace:^",
    "@flowforge/fs-sandbox": "workspace:^",
    "@flowforge/goal": "workspace:^",
    "@flowforge/goal-round-driver": "workspace:^",
    "@flowforge/api-gateway": "workspace:^",
    "@flowforge/harness-env-registry": "workspace:^",
