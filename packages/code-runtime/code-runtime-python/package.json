{
  "name": "@flowforge/code-runtime-python",
  "description": "Python subprocess implementation of the FlowForge code-execution seam (port of dsh code-runtime-python)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/code-runtime/code-runtime-python"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts",
    "py/bootstrap.py",
    "py/protocol.py"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/code-runtime": "workspace:^",
    "@flowforge/invariants": "workspace:^",
    "@flowforge/session": "workspace:^",
    "@flowforge/timeout": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  },
  "dependencies": {
    "@flowforge/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/code-runtime": "workspace:^",
    "@flowforge/invariants": "workspace:^",
    "@flowforge/session": "workspace:^",
    "@flowforge/timeout": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  }
}