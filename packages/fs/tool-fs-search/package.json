{
  "name": "@flowforge/tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@flowforge/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@flowforge/invariants": "workspace:^",
    "@flowforge/llm": "workspace:^",
    "@flowforge/output-retention": "workspace:^",
    "@flowforge/session": "workspace:^",
    "@flowforge/spill": "workspace:^",
    "@flowforge/subprocess": "workspace:^",
    "@flowforge/system-prompt": "workspace:^",
    "@flowforge/timeout": "workspace:^",
    "@flowforge/tools": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/agent": "workspace:^",
    "@flowforge/subprocess": "workspace:^",
    "@flowforge/subprocess-local": "workspace:^",
    "@flowforge/invariants": "workspace:^",
    "@flowforge/llm": "workspace:^",
    "@flowforge/output-retention": "workspace:^",
    "@flowforge/session": "workspace:^",
    "@flowforge/spill": "workspace:^",
    "@flowforge/system-prompt": "workspace:^",
    "@flowforge/timeout": "workspace:^",
    "@flowforge/tools": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  }
}
