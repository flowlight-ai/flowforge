{
  "name": "@flowforge/tool-fs",
  "description": "Model-facing filesystem tools (read, write, edit) over the FlowForge filesystem seam (ctx.fs)",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/fs/tool-fs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^9.0.0",
    "@flowforge/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@flowforge/attachment": "workspace:^",
    "@flowforge/fs": "workspace:^",
    "@flowforge/invariants": "workspace:^",
    "@flowforge/llm": "workspace:^",
    "@flowforge/sandbox": "workspace:^",
    "@flowforge/sandbox-policy": "workspace:^",
    "@flowforge/session": "workspace:^",
    "@flowforge/system-prompt": "workspace:^",
    "@flowforge/tools": "workspace:^",
    "@flowforge/user-approval": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/agent": "workspace:^",
    "@flowforge/agent-loop": "workspace:^",
    "@flowforge/agent-loop-testkit": "workspace:^",
    "@flowforge/attachment": "workspace:^",
    "@flowforge/fs": "workspace:^",
    "@flowforge/fs-local": "workspace:^",
    "@flowforge/fs-observation-policy": "workspace:^",
    "@flowforge/invariants": "workspace:^",
    "@flowforge/llm": "workspace:^",
    "@flowforge/llm-deepseek": "workspace:^",
    "@flowforge/sandbox": "workspace:^",
    "@flowforge/sandbox-policy": "workspace:^",
    "@flowforge/session": "workspace:^",
    "@flowforge/system-prompt": "workspace:^",
    "@flowforge/tools": "workspace:^",
    "@flowforge/user-approval": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  }
}
