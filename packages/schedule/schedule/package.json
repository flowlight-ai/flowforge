{
  "name": "@flowforge/schedule",
  "description": "Agent-scoped durable after, at, and fixed-rate reminders over the session event log",
  "version": "0.1.0-rc.5",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/flowlight-ai/flowforge.git",
    "directory": "packages/schedule/schedule"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@flowforge/agent": "workspace:^",
    "@flowforge/brand": "workspace:^",
    "@flowforge/invariants": "workspace:^",
    "@flowforge/llm": "workspace:^",
    "@flowforge/session": "workspace:^",
    "@flowforge/session-persistence": "workspace:^",
    "@flowforge/tools": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  },
  "devDependencies": {
    "@flowforge/cordis-plugin-loader": "workspace:^",
    "@flowforge/agent": "workspace:^",
    "@flowforge/agent-loop": "workspace:^",
    "@flowforge/agent-loop-testkit": "workspace:^",
    "@flowforge/brand": "workspace:^",
    "@flowforge/invariants": "workspace:^",
    "@flowforge/llm": "workspace:^",
    "@flowforge/session": "workspace:^",
    "@flowforge/session-persistence": "workspace:^",
    "@flowforge/session-persistence-jsonl": "workspace:^",
    "@flowforge/system-prompt": "workspace:^",
    "@flowforge/tools": "workspace:^",
    "@flowforge/cordis": "workspace:^"
  }
}
