# FlowForge environment variables template.
#
# Copy this file to `.env` (in the same directory) and adjust the values.
# The `.env` file is gitignored — never commit real secrets.
#
# Cross-platform path conventions:
#   - All paths use forward slashes `/` (works on Windows/Linux/macOS)
#   - Windows example: D:/projects/flowlight-ai
#   - Linux/macOS example: ~/projects/flowlight-ai
#   - No trailing slashes
#   - ${...} placeholders in YAML files are resolved at runtime by core/config.py
#
# Override precedence (highest → lowest):
#   1. Process environment variables (export FOO=bar)
#   2. .env file (this file)
#   3. config/*.yaml defaults

# ─────────────────────────────────────────────────────────────────────────────
# Path roots (cross-platform)
# ─────────────────────────────────────────────────────────────────────────────

# flowlight-ai organization root (parent of all projects in the ecosystem)
FLOWLIGHT_AI_ROOT="D:/projects/flowlight-ai"

# FlowForge working directory (state, checkpoints, intermediate artifacts)
FLOWFORGE_WORK_DIR="${FLOWLIGHT_AI_ROOT}/flowforge/.work"

# FlowForge logs directory
FLOWFORGE_LOG_DIR="${FLOWFORGE_WORK_DIR}/logs"

# ─────────────────────────────────────────────────────────────────────────────
# LLM routing (overrides config/llm_route.yaml)
# ─────────────────────────────────────────────────────────────────────────────

# OpenRoute gateway (preferred — see llm_route.yaml providers.openroute)
FLOWFORGE_LLM_ROUTE_OPENROUTE_BASE_URL="http://localhost:13000"
FLOWFORGE_LLM_ROUTE_OPENROUTE_API_KEY=""

# Direct providers (optional — enable in llm_route.yaml to use)
FLOWFORGE_LLM_ROUTE_DIRECT_ANTHROPIC_API_KEY=""
FLOWFORGE_LLM_ROUTE_DIRECT_OPENAI_API_KEY=""
FLOWFORGE_LLM_ROUTE_DIRECT_ZHIPU_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# Self-evolution (overrides config/evolution.yaml)
# ─────────────────────────────────────────────────────────────────────────────

# Quality threshold for Loop verification (default 0.85)
FLOWFORGE_EVOLUTION_QUALITY_THRESHOLD="0.85"

# Max Loop iterations (default 5)
FLOWFORGE_EVOLUTION_LOOP_MAX_ITERATIONS="5"

# LLM call timeout (seconds) — webchat ≤ 30s, creation/refinement ≤ 180s
FLOWFORGE_EVOLUTION_LLM_TIMEOUT_SECONDS="90"
FLOWFORGE_EVOLUTION_LLM_LONG_ARTICLE_TIMEOUT_SECONDS="120"
FLOWFORGE_EVOLUTION_LLM_MAX_RETRIES="3"

# ─────────────────────────────────────────────────────────────────────────────
# Debug & observability
# ─────────────────────────────────────────────────────────────────────────────

# Debug logging (0=off, 1=on) — logs LLM inputs/outputs/timings
FLOWFORGE_DEBUG="0"

# Trace level (ERROR / WARN / INFO / DEBUG)
FLOWFORGE_TRACE_LEVEL="INFO"

# ─────────────────────────────────────────────────────────────────────────────
# T7/T8 verification
# ─────────────────────────────────────────────────────────────────────────────

# T7: LLM cross-vendor review of LLM-generated content
FLOWFORGE_T7_AUDIT_ENABLED="1"

# T8: DOM verification — CDP browser automation (requires Chrome/Edge installed)
FLOWFORGE_T8_DOM_VERIFICATION_ENABLED="0"
FLOWFORGE_T8_CDP_BROWSER_PATH=""
