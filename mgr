#!/bin/bash
# ============================================================================
# mgr — FlowLight 多仓库管理 (平台感知 + 跨平台合并)
#
# 平台模型 (脚本位置决定当前平台):
#   <workspace>/flowlight/<repo>/mgr    → 当前平台=Gitee  (origin=gitee.com,  base=master)
#   <workspace>/flowlight-ai/<repo>/mgr → 当前平台=GitHub (origin=github.com, base=main)
#
# 核心原则:
#   1. 平台感知 — commit/push/pr/sync 等命令仅操作当前平台, 不再同时推送双端
#   2. 跨平台合并 — 使用 merge-cross 命令手动触发, 读取双端提交差异并创建同步PR
#   3. 主干保护 — 禁止直接 push 到 master/main, 一律经 PR 合入
#
# 作用域 (本仓库脚本, 仅管理自身):
#   ./mgr         → 默认仅管理本仓库 (flowforge)
#   --all         → 对本仓库仍只操作本仓库
#   --repo NAME   → 仅管理指定仓库 (本仓库仅可填 flowforge)
#
# 用法:
#   ./mgr [--all|--repo NAME] status | commit | push | pull | log | diff | branch | list
#   ./mgr commit "type(scope): 描述 [署名]"   提交到当前平台 (强制规范检查)
#   ./mgr push [--pr] [--title "PR标题"] [--body "PR描述"]   push 当前分支
#   ./mgr pr "type(scope): 描述 [署名]" [--body "PR描述"]   创建PR (当前平台)
#   ./mgr sync "type(scope): 描述 [署名]" [--body "PR描述"]  提交+push+PR
#   ./mgr merge-cross [--dry-run] [--g2l|--l2g]   跨平台双向合并 (手动触发)
#   ./mgr mirror-setup          配置双端互指 mirror 远程
#   ./mgr protect               设置 master 分支保护 (仅Gitee)
#
# 规范强制检查 (git-workflow.md §3):
#   commit/pr/sync 的标题必须符合 type(scope): 描述 [智能体ID] 格式
#   合法 type: feat fix refactor chore docs test ci perf style build
#   合法署名: wenxin sherlock luban vangogh davinci keane humming sqrl butterfly
#   不合规则本地报错中止, 不会提交或创建 PR
#
# merge-cross 工作流:
#   1. 在某个平台开发并合入 PR 后, 运行 ./mgr merge-cross --dry-run 查看差异
#   2. 确认后运行 ./mgr merge-cross 创建双向同步PR
#   3. 分别在两个平台合入同步PR
#   4. 若有冲突, 解决后重新运行
# ============================================================================
set -e
_git() { local d="$1"; shift; (cd "$d" && git "$@"); }

# ── 路径 & 平台检测 ───────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
GITEE_ORG="flowlight-ai"; GH_ORG="flowlight-ai"
SELF="$(basename "$SCRIPT_DIR")"

# 平台检测: 脚本路径含 flowlight-ai → GitHub, 否则 → Gitee
# 路径计算需根据当前平台决定哪个是"本端"、哪个是"对端"
if [[ "$SCRIPT_DIR" == *flowlight-ai* ]]; then
  CURRENT_SIDE="github"
  ROOT_GITHUB="$(cd "$SCRIPT_DIR/.." && pwd)"
  ROOT_GITEE="$(cd "$(dirname "$ROOT_GITHUB")/flowlight" 2>/dev/null && pwd || echo "$(dirname "$ROOT_GITHUB")/flowlight")"
else
  CURRENT_SIDE="gitee"
  ROOT_GITEE="$(cd "$SCRIPT_DIR/.." && pwd)"
  ROOT_GITHUB="$(cd "$(dirname "$ROOT_GITEE")/flowlight-ai" 2>/dev/null && pwd || echo "$(dirname "$ROOT_GITEE")/flowlight-ai")"
fi

# ── 仓库注册 ──────────────────────────────────────────────────
declare -a NAMES=()
declare -A GPATH=()    # gitee 本地路径
declare -A GH_PATH=()  # github 本地路径
declare -A GURL=()     # gitee 远程 URL
declare -A GH_URL=()   # github 远程 URL

reg() { local n="$1" gr="$2" ghr="$3"; NAMES+=("$n")
  GPATH["$n"]="$ROOT_GITEE/$gr"; GH_PATH["$n"]="$ROOT_GITHUB/$ghr"
  GURL["$n"]="https://gitee.com/${GITEE_ORG}/${n}.git"
  GH_URL["$n"]="https://github.com/${GH_ORG}/${n}.git"; }

# 本仓库仅注册自身 (项目间去耦合, 不感知其他仓库)
reg "$SELF" "$SELF" "$SELF"

# ── 作用域解析 ────────────────────────────────────────────────
SCOPE="default"
SCOPE_REPO=""
while [ $# -gt 0 ]; do
  case "$1" in
    --all)  SCOPE="all"; shift ;;
    --repo) SCOPE="repo"; SCOPE_REPO="${2:-}"; shift 2 ;;
    *) break ;;
  esac
done
if [ "$SCOPE" = "default" ]; then SCOPE="self"; fi
case "$SCOPE" in
  all)  : ;;
  self) NAMES=("$SELF") ;;
  repo)
    if [[ ! " ${NAMES[*]} " =~ " ${SCOPE_REPO} " ]]; then
      echo "错误: 未知仓库 '$SCOPE_REPO' (可选: ${NAMES[*]})" >&2; exit 1
    fi
    NAMES=("$SCOPE_REPO") ;;
esac

# ── 颜色 ──────────────────────────────────────────────────────
R='\033[0;31m'; G='\033[0;32m'; Y='\033[1;33m'; C='\033[0;36m'; B='\033[1m'; N='\033[0m'

# ── Token ─────────────────────────────────────────────────────
load_token() {
  local f="$SCRIPT_DIR/.mgr-token"
  [ ! -f "$f" ] && f="$ROOT_GITEE/.mgr-token"
  [ -f "$f" ] && MGR_TOKEN="$(cat "$f"|tr -d '[:space:]')" || MGR_TOKEN="${GITEE_TOKEN:-}"; }
load_gh_token() { MGR_GH_TOKEN="${GITHUB_TOKEN:-}"; [ -z "$MGR_GH_TOKEN" ] && [ -f "$HOME/.github-token" ] && MGR_GH_TOKEN="$(cat "$HOME/.github-token"|tr -d '[:space:]')"; }

# ── 辅助 ──────────────────────────────────────────────────────
usage() { sed -n '2,38p' "$0"; exit 0; }

# 当前平台目录
_cur_dir() { [ "$CURRENT_SIDE" = "gitee" ] && echo "${GPATH[$1]}" || echo "${GH_PATH[$1]}"; }
# 当前平台主干分支名
_cur_base() { [ "$CURRENT_SIDE" = "gitee" ] && echo "master" || echo "main"; }

# ═══════════════════════════════════════════════════════════════
#  平台感知命令 (仅操作当前平台)
# ═══════════════════════════════════════════════════════════════

cmd_status() {
  # 默认仅显示当前平台 (用本地 origin 缓存, 不 fetch, 避免多仓库卡住)
  # --cross  显示双端 (帮助判断是否需要 merge-cross)
  # --fetch  先 fetch 远端再显示 (慢, 但 ↑↓ 精确)
  local CROSS=false DO_FETCH=false
  while [ $# -gt 0 ]; do
    case "$1" in
      --cross) CROSS=true; shift ;;
      --fetch) DO_FETCH=true; shift ;;
      *) shift ;;
    esac
  done
  local sides=("$CURRENT_SIDE")
  $CROSS && sides=(gitee github)
  for n in "${NAMES[@]}"; do
    for side in "${sides[@]}"; do
      local d; [ "$side" = "gitee" ] && d="${GPATH[$n]}" || d="${GH_PATH[$n]}"
      [ ! -d "$d/.git" ] && continue
      local out; out=$(_git "$d" status --short 2>&1) || true
      [ -n "$out" ] && { echo -e "${B}${Y}-- ${n} (${side}) --${N}"; echo "$out"; }
    done
  done
  echo -e "${B}分支 & 同步状态 (当前平台: ${C}${CURRENT_SIDE}${B})${CROSS:+ ${Y}[--cross 双端]${N}}${DO_FETCH:+ ${Y}[--fetch 精确]${N}}${B}:${N}"
  for n in "${NAMES[@]}"; do
    for side in "${sides[@]}"; do
      local d; [ "$side" = "gitee" ] && d="${GPATH[$n]}" || d="${GH_PATH[$n]}"
      [ ! -d "$d/.git" ] && continue
      local b; b=$(_git "$d" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
      $DO_FETCH && _git "$d" fetch origin &>/dev/null || true
      local a=$(_git "$d" rev-list --count "origin/${b}..${b}" 2>/dev/null || echo "?")
      local be=$(_git "$d" rev-list --count "${b}..origin/${b}" 2>/dev/null || echo "?")
      local mark="  "; [ "$side" = "$CURRENT_SIDE" ] && mark="${G}→ ${N}"
      printf "%s%-14s ${C}%-7s${N} [${Y}%s${N}] ${G}↑%s${N} ${R}↓%s${N}\n" "$mark" "$n" "$side" "$b" "$a" "$be"
    done
  done
  echo ""
}

cmd_commit() {
  local m="$*"; [ -z "$m" ] && { echo -e "${R}缺少 commit message${N}"; exit 1; }
  # 强制规范检查 (git-workflow.md §3): type(scope): 描述 [署名]
  if ! _check_msg_format "$m" "commit"; then
    echo -e "${R}提交已中止。请按规范格式: type(scope): 描述 [署名]${N}" >&2
    exit 1
  fi
  for n in "${NAMES[@]}"; do
    local d; d=$(_cur_dir "$n")
    [ -d "$d/.git" ] || continue
    _git "$d" add -A
    _git "$d" diff --cached --quiet && continue
    echo -e "${B}${n} (${CURRENT_SIDE})${N}"
    _git "$d" commit -m "$m" 2>&1 | tail -1
  done
  echo ""
}

# ═══════════════════════════════════════════════════════════════
#  智能推送 (核心): merge 远端更新到当前分支, push 同一分支累加到已有 PR
#  原则: 不 rebase 不丢本地修改 / 不删不重建 PR / merge 主干保证 PR 无冲突
# ═══════════════════════════════════════════════════════════════
_smart_push() {
  local n="$1" d="$2" b="$3" title="${4:-}" body="${5:-}" do_pr="${6:-false}"
  local base; base=$(_cur_base)
  # stash 未提交修改 (合并前保护工作区)
  local stashed=false
  if ! _git "$d" diff --quiet 2>/dev/null || ! _git "$d" diff --cached --quiet 2>/dev/null; then
    _git "$d" stash 2>/dev/null && stashed=true
  fi
  # 1) origin/<b> 有新提交 → merge (累加别人对该 PR 分支的修改, 保留双方历史)
  if _git "$d" show-ref --verify --quiet "refs/remotes/origin/${b}"; then
    local be; be=$(_git "$d" rev-list --count "${b}..origin/${b}" 2>/dev/null || echo 0)
    if [ "$be" -gt 0 ]; then
      echo -e "  ${C}merge origin/${b} (${be} 个提交) → 累加到本分支 (保留双方历史, 不 rebase)${N}"
      if ! _git "$d" merge --no-edit "origin/${b}" 2>"$MGR_TMP"; then
        _git "$d" merge --abort 2>/dev/null || true
        $stashed && _git "$d" stash pop 2>/dev/null || true
        echo -e "  ${R}✗ 与 origin/${b} 存在真实冲突, 需手动解决 (本地 ${b} 已保留未改动, 未删任何 PR)${N}"
        echo -e "  ${Y}指引: cd $d && git merge origin/${b} && 解决冲突 && git add . && git commit${N}"
        return 1
      fi
    fi
  fi
  # 2) 本分支未含最新 origin/base → merge 主干 (保证 PR 合并无冲突, 不 rebase 不丢本地)
  local mb ob
  mb=$(_git "$d" merge-base "$b" "origin/${base}" 2>/dev/null || echo "")
  ob=$(_git "$d" rev-parse "origin/${base}" 2>/dev/null || echo "")
  if [ -n "$mb" ] && [ -n "$ob" ] && [ "$mb" != "$ob" ]; then
    echo -e "  ${C}merge origin/${base} (主干已更新) → 保证 PR 无冲突${N}"
    if ! _git "$d" merge --no-edit "origin/${base}" 2>"$MGR_TMP"; then
      _git "$d" merge --abort 2>/dev/null || true
      $stashed && _git "$d" stash pop 2>/dev/null || true
      echo -e "  ${R}✗ 与 origin/${base} 存在真实冲突, 需手动解决 (本地 ${b} 已保留未改动, 未删任何 PR)${N}"
      echo -e "  ${Y}指引: cd $d && git merge origin/${base} && 解决冲突 && git add . && git commit${N}"
      return 1
    fi
  fi
  # 恢复 stash
  $stashed && _git "$d" stash pop 2>/dev/null || true
  # 3) push 同一分支 (累加到已有 PR, 不新建 PR)
  echo -ne "  ${B}${n} (${CURRENT_SIDE}) → origin/${b} ... ${N}"
  if _git "$d" push -u origin "$b" 2>"$MGR_TMP"; then
    echo -e "${G}OK${N}"
    $do_pr && _ensure_pr "$n" "$d" "$b" "$title" "$body"
    return 0
  else
    echo -e "${R}FAIL${N}"; sed 's/^/    /' "$MGR_TMP" | head -6
    return 1
  fi
}

# 确保分支有 PR: 已存在则报告 (累加更新), 不存在则创建 (绝不重复创建/删除重建)
_ensure_pr() {
  local n="$1" d="$2" b="$3" title="${4:-merge: ${b}}" body="${5:-}"
  load_token; load_gh_token
  local side; case "$d" in *flowlight-ai*) side="github";; *) side="gitee";; esac
  local base; [ "$side" = "gitee" ] && base="master" || base="main"
  local exists_url=""
  if [ "$side" = "gitee" ] && [ -n "$MGR_TOKEN" ]; then
    exists_url=$(curl -s "https://gitee.com/api/v5/repos/${GITEE_ORG}/${n}/pulls?state=open&head=${GITEE_ORG}:${b}&access_token=${MGR_TOKEN}" 2>/dev/null | python3 -c "import sys,json; d=json.load(sys.stdin); print(d[0]['html_url'] if isinstance(d,list) and d else '')" 2>/dev/null || echo "")
  elif [ "$side" = "github" ] && [ -n "$MGR_GH_TOKEN" ]; then
    exists_url=$(curl -s "https://api.github.com/repos/${GH_ORG}/${n}/pulls?state=open&head=${GH_ORG}:${b}" -H "Authorization: token ${MGR_GH_TOKEN}" 2>/dev/null | python3 -c "import sys,json; d=json.load(sys.stdin); print(d[0]['html_url'] if isinstance(d,list) and d else '')" 2>/dev/null || echo "")
  fi
  if [ -n "$exists_url" ]; then
    echo -e "    ${G}已有 PR 已累加更新 (未重建): $exists_url${N}"
    return 0
  fi
  _create_pr "$n" "$d" "$b" "$title" "$body"
}

cmd_push() {
  local MGR_TMP; MGR_TMP="$(mktemp)"
  local DO_PR=false PR_TITLE="" PR_BODY=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --pr) DO_PR=true; shift ;;
      --title) PR_TITLE="$2"; shift 2 ;;
      --body) PR_BODY="$2"; shift 2 ;;
      *) break ;;
    esac
  done
  local base; base=$(_cur_base)
  for n in "${NAMES[@]}"; do
    [ -n "${1:-}" -a "$n" != "${1:-}" ] && continue
    local d; d=$(_cur_dir "$n")
    [ -d "$d/.git" ] || continue
    local b=$(_git "$d" rev-parse --abbrev-ref HEAD)
    # 主干保护
    if [ "$b" = "$base" ]; then
      echo -e "  ${Y}${n}: 在主干 ${b} 上, 禁止直接push, 请用 ./mgr sync 或先切分支${N}"
      continue
    fi
    _git "$d" fetch origin 2>/dev/null || true
    local t="$PR_TITLE"
    [ -z "$t" ] && t=$(_git "$d" log -1 --format=%s 2>/dev/null || echo "feat: merge [sherlock]")
    echo -e "${B}${n} (${CURRENT_SIDE}) [${b}]${N}"
    _smart_push "$n" "$d" "$b" "$t" "$PR_BODY" "$DO_PR"
  done
  rm -f "$MGR_TMP"; echo ""
}

cmd_pr() {
  # 用法: ./mgr pr "标题" [--body "描述"]
  local title="" body=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --body) body="$2"; shift 2 ;;
      *) title="$1"; shift ;;
    esac
  done
  [ -z "$title" ] && title="feat: merge to trunk [sherlock]"
  # 强制规范检查
  if ! _check_msg_format "$title" "PR标题"; then
    echo -e "${R}PR 创建已中止。请按规范格式: type(scope): 描述 [署名]${N}" >&2
    exit 1
  fi
  load_token; load_gh_token
  local base; base=$(_cur_base)
  for n in "${NAMES[@]}"; do
    local d; d=$(_cur_dir "$n")
    [ -d "$d/.git" ] || continue
    local b; b=$(_git "$d" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
    echo -e "${B}═══ ${n} (${CURRENT_SIDE}) PR (head=${b}) ═══${N}"
    if [ "$b" = "$base" ]; then
      echo -e "  ${Y}在主干 ${b} 上, head==base 无法创建PR${N}"
      echo -e "  ${Y}请先切到非主干分支: git checkout -b feat/xxx${N}"
      continue
    fi
    _ensure_pr "$n" "$d" "$b" "$title" "$body"
    echo ""
  done
}

cmd_sync() {
  # 当前平台: commit dirty + 智能push + PR (主干自动建临时分支, 功能分支累加到已有 PR)
  # 用法: ./mgr sync "PR标题" [--body "PR描述"]
  local pr_title="" pr_body=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --body) pr_body="$2"; shift 2 ;;
      *) [ -z "$pr_title" ] && pr_title="$1"; shift ;;
    esac
  done
  [ -z "$pr_title" ] && pr_title="chore: platform sync [sherlock]"
  # 规范检查
  if ! _check_msg_format "$pr_title" "sync PR标题"; then
    echo -e "${R}sync 已中止。请按规范格式: type(scope): 描述 [署名]${N}" >&2
    exit 1
  fi
  local base; base=$(_cur_base)
  local MGR_TMP; MGR_TMP="$(mktemp)"
  load_token; load_gh_token
  for n in "${NAMES[@]}"; do
    local d; d=$(_cur_dir "$n")
    [ -d "$d/.git" ] || continue
    local b; b=$(_git "$d" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
    local dirty; dirty=$(_git "$d" status --short 2>/dev/null | wc -l)

    echo -e "${B}══ ${n} (${CURRENT_SIDE}) [${b}]${N}"

    if ! _git "$d" fetch origin 2>"$MGR_TMP"; then
      echo -e "  ${R}✗ fetch 失败: $(head -1 "$MGR_TMP")${N}"; continue
    fi

    # 主干: 创建临时分支基于 origin/base (保证 PR 无冲突), 提交 dirty, 智能推送
    if [ "$b" = "$base" ]; then
      local ts; ts=$(date +%s | tail -c 5)
      local sb="sync/${base}-${ts}"
      _git "$d" checkout -b "$sb" "origin/${base}" 2>"$MGR_TMP" || { echo -e "  ${R}✗ 创建临时分支失败${N}"; continue; }
      [ "$dirty" -gt 0 ] && { _git "$d" add -A; _git "$d" commit -m "$pr_title" 2>/dev/null || true; }
      _smart_push "$n" "$d" "$sb" "$pr_title" "$pr_body" true
      _git "$d" checkout "$base" 2>/dev/null || true
      _git "$d" branch -D "$sb" 2>/dev/null || true
    else
      # 功能分支: 先提交 dirty, 再智能推送 (merge 远端+主干, push 同一分支累加到已有 PR)
      [ "$dirty" -gt 0 ] && { _git "$d" add -A; _git "$d" commit -m "$pr_title" 2>/dev/null || true; }
      _smart_push "$n" "$d" "$b" "$pr_title" "$pr_body" true
    fi
    echo ""
  done
  rm -f "$MGR_TMP"
}

cmd_pull() {
  local MGR_TMP; MGR_TMP="$(mktemp)"
  local base; base=$(_cur_base)
  for n in "${NAMES[@]}"; do
    [ -n "${1:-}" -a "$n" != "${1:-}" ] && continue
    local d; d=$(_cur_dir "$n")
    [ -d "$d/.git" ] || continue
    local b; b=$(_git "$d" branch --show-current 2>/dev/null || echo "?")
    echo -e "${B}══ ${n} (${CURRENT_SIDE}) [${b}]${N}"
    if ! _git "$d" fetch origin 2>"$MGR_TMP"; then
      echo -e "  ${R}✗ fetch origin 失败: $(head -2 "$MGR_TMP"|tr '\n' ' ')${N}"; continue
    fi
    # 远端无同名分支: 自动切回默认工作分支并拉取 (PR 合入后临时/功能分支远端被删的常见场景)
    # 保护未提交修改: 有 dirty 则不切换, 仅提示
    if ! _git "$d" show-ref --verify --quiet "refs/remotes/origin/${b}"; then
      _git "$d" remote set-head origin -a &>/dev/null || true
      local rb; rb=$(_git "$d" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')
      [ -z "$rb" ] && rb="$base"
      # 有未提交修改: 不切换 (保护本地工作)
      if ! _git "$d" diff --quiet 2>/dev/null || ! _git "$d" diff --cached --quiet 2>/dev/null; then
        echo -e "  ${Y}⚠ 远端无 origin/${b}, 且本地有未提交修改, 已保留在 ${b}${N}"
        echo -e "  ${Y}  请先 commit/stash, 再: git checkout ${rb} && git pull${N}"
        continue
      fi
      # 干净: 切回默认分支并拉取
      if [ "$b" != "$rb" ]; then
        if _git "$d" checkout -q "$rb" 2>"$MGR_TMP"; then
          # 旧分支已合入默认分支 → 删除本地旧分支 (保持整洁); 否则保留
          if _git "$d" merge-base --is-ancestor "$b" "$rb" 2>/dev/null; then
            _git "$d" branch -q -D "$b" 2>/dev/null || true
            echo -e "  ${G}✓ ${b} 已合入 ${rb}, 切回 ${rb} 并清理旧分支${N}"
          else
            echo -e "  ${G}✓ 远端无 origin/${b}, 切回默认分支 ${rb} (本地 ${b} 保留)${N}"
          fi
        else
          echo -e "  ${Y}⚠ 切换到 ${rb} 失败: $(head -1 "$MGR_TMP"), 保留在 ${b}${N}"; continue
        fi
      fi
      if _git "$d" merge --ff-only -q "origin/${rb}" 2>"$MGR_TMP"; then
        echo -e "  ${G}✓ ${rb} 已更新到最新${N}"
      else
        echo -e "  ${Y}⚠ ${rb} 快进失败: $(head -1 "$MGR_TMP")${N}"
      fi
      continue
    fi
    local a be
    a=$(_git "$d" rev-list --count "origin/${b}..${b}" 2>/dev/null || echo 0)
    be=$(_git "$d" rev-list --count "${b}..origin/${b}" 2>/dev/null || echo 0)
    if [ "$a" = 0 ] && [ "$be" = 0 ]; then echo -e "  ${G}✓ 已同步${N}"; continue; fi
    if [ "$a" != 0 ] && [ "$be" = 0 ]; then
      echo -e "  ${Y}↑ 本地领先 ${a} 个提交 (待 PR 合入或待 push), 无需拉取${N}"; continue
    fi
    if [ "$a" = 0 ]; then
      if _git "$d" merge --ff-only -q "origin/${b}" 2>"$MGR_TMP"; then
        echo -e "  ${G}✓ 已快进 ${be} 个提交${N}"
      else
        echo -e "  ${R}✗ 快进失败: $(head -1 "$MGR_TMP")${N}"
      fi
      continue
    fi
    # 分叉: 用 merge (不 rebase, 不丢本地提交)
    echo -e "  ${Y}⚠ 分叉: 本地领先 ${a} / 远端领先 ${be} → merge (保留双方历史)${N}"
    echo "  本地独有:"; _git "$d" log --oneline "origin/${b}..${b}" | head -5 | sed 's/^/    /'
    echo "  远端独有:"; _git "$d" log --oneline "${b}..origin/${b}" | head -5 | sed 's/^/    /'
    if _git "$d" merge --no-edit "origin/${b}" 2>"$MGR_TMP"; then
      echo -e "  ${G}✓ merge 成功${N}"
    else
      _git "$d" merge --abort 2>/dev/null || true
      echo -e "  ${R}✗ merge 失败已还原 (本地 ${b} 保留): $(head -1 "$MGR_TMP")${N}"
      echo -e "  ${Y}指引: cd $d && git merge origin/${b} && 解决冲突 && git commit${N}"
    fi
  done
  rm -f "$MGR_TMP"; echo ""
}

cmd_log() {
  local L=5; [ -n "${1:-}" ] && [[ "${1:-}" =~ ^[0-9]+$ ]] && { L="$1"; shift; }
  for n in "${NAMES[@]}"; do
    local d; d=$(_cur_dir "$n")
    [ -d "$d/.git" ] || continue
    echo -e "${B}${n} (${CURRENT_SIDE})${N}"
    _git "$d" log --oneline -"$L"
  done
  echo ""
}

cmd_diff() {
  for n in "${NAMES[@]}"; do
    local d; d=$(_cur_dir "$n")
    [ -d "$d/.git" ] || continue
    local out; out=$(_git "$d" diff --stat 2>&1)
    [ -n "$out" ] && { echo -e "${B}${n} (${CURRENT_SIDE})${N}"; echo "$out"; }
  done
  echo ""
}

cmd_branch() {
  for n in "${NAMES[@]}"; do
    local d; d=$(_cur_dir "$n")
    [ -d "$d/.git" ] || continue
    printf "  %-14s %s (%s)\n" "$n" "$(_git "$d" branch --show-current)" "$CURRENT_SIDE"
  done
  echo ""
}

# ═══════════════════════════════════════════════════════════════
#  跨平台命令
# ═══════════════════════════════════════════════════════════════

cmd_mirror_setup() {
  local QUIET=false
  [ "${1:-}" = "--quiet" ] && QUIET=true
  for n in "${NAMES[@]}"; do
    $QUIET || echo -e "${B}${n}:${N}"
    local gd="${GPATH[$n]}" ghd="${GH_PATH[$n]}"
    if [ -d "$gd/.git" ]; then
      _git "$gd" remote get-url github &>/dev/null && _git "$gd" remote set-url github "${GH_URL[$n]}" || _git "$gd" remote add github "${GH_URL[$n]}" 2>/dev/null
      $QUIET || echo "  gitee: github mirror ready"
    fi
    if [ -d "$ghd/.git" ]; then
      _git "$ghd" remote get-url gitee &>/dev/null && _git "$ghd" remote set-url gitee "${GURL[$n]}" || _git "$ghd" remote add gitee "${GURL[$n]}" 2>/dev/null
      $QUIET || echo "  github: gitee mirror ready"
    fi
  done
  $QUIET || echo -e "\n${B}mirror 远程已配置, 可运行 ${C}./mgr merge-cross${N}${B} 进行跨平台合并${N}"
}

cmd_merge_cross() {
  # 跨平台双向合并: 基于文件内容(tree hash)比较双端差异, 创建同步PR
  # 用法: ./mgr merge-cross [--dry-run] [--g2l|--l2g]
  #   --dry-run  仅显示文件差异, 不创建PR
  #   --g2l      仅 GitHub→Gitee
  #   --l2g      仅 Gitee→GitHub
  #   默认: 双向
  # 原理: tree hash = 文件内容指纹, 相同=双端一致; 不同=显示文件diff并merge
  #       (不受 squash merge / 提交历史分叉影响, 只看最终文件内容)
  local DRY_RUN=false DO_G2L=true DO_L2G=true
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) DRY_RUN=true; shift ;;
      --g2l) DO_L2G=false; shift ;;
      --l2g) DO_G2L=false; shift ;;
      *) shift ;;
    esac
  done

  load_token; load_gh_token

  echo -e "${B}════════ 跨平台合并 (${CURRENT_SIDE} 触发) ════════${N}"
  $DRY_RUN && echo -e "${Y}[DRY-RUN] 仅显示文件差异, 不创建PR${N}\n"

  for n in "${NAMES[@]}"; do
    local gd="${GPATH[$n]}" ghd="${GH_PATH[$n]}"
    if [ ! -d "$gd/.git" ] || [ ! -d "$ghd/.git" ]; then
      echo -e "${Y}${n}: 跳过 (双端目录不完整)${N}"; continue
    fi

    echo -e "${B}═══ ${n} ═══${N}"

    # 构建 token URL (避免依赖 mirror 远程配置)
    local gh_fetch_url ge_fetch_url
    gh_fetch_url="https://github.com/${GH_ORG}/${n}.git"
    ge_fetch_url="https://gitee.com/${GITEE_ORG}/${n}.git"
    [ -n "$MGR_GH_TOKEN" ] && gh_fetch_url="https://${MGR_GH_TOKEN}@github.com/${GH_ORG}/${n}.git"
    [ -n "$MGR_TOKEN" ] && ge_fetch_url="https://${MGR_TOKEN}@gitee.com/${GITEE_ORG}/${n}.git"

    # 在 gitee 目录 fetch github/main → FETCH_HEAD
    _git "$gd" fetch "$gh_fetch_url" main 2>/dev/null || true
    local gh_ref; gh_ref=$(_git "$gd" rev-parse FETCH_HEAD 2>/dev/null || echo "")
    if [ -z "$gh_ref" ]; then
      echo -e "  ${R}✗ 无法从 GitHub fetch (检查网络/token)${N}"; continue
    fi

    # 比较 tree hash (文件内容指纹, 不受 squash merge / 提交历史影响)
    local ge_tree gh_tree
    ge_tree=$(_git "$gd" rev-parse "master^{tree}" 2>/dev/null || echo "")
    gh_tree=$(_git "$gd" rev-parse "FETCH_HEAD^{tree}" 2>/dev/null || echo "")

    if [ "$ge_tree" = "$gh_tree" ] && [ -n "$ge_tree" ]; then
      echo -e "  ${G}✓ 双端文件内容一致 (tree: ${ge_tree:0:8})${N}"
      echo ""; continue
    fi

    # 显示文件级差异 (不显示提交历史, 避免误报)
    echo -e "  ${C}文件差异 (Gitee master ←→ GitHub main):${N}"
    _git "$gd" diff --stat "master" "FETCH_HEAD" 2>/dev/null | head -20 | sed 's/^/    /'

    $DRY_RUN && { echo ""; continue; }

    local ts branch

    # ── github→gitee: merge GitHub main 到 Gitee ──
    if $DO_G2L; then
      ts=$(date +%s | tail -c 5)
      branch="cross/gh2ge-${ts}"
      echo -e "  ${C}→ 创建 GitHub→Gitee 同步PR ...${N}"
      # 暂存未提交的本地更改, 避免合并冲突
      local gd_stashed=false
      if ! _git "$gd" diff --quiet 2>/dev/null || ! _git "$gd" diff --cached --quiet 2>/dev/null; then
        _git "$gd" stash 2>/dev/null && gd_stashed=true
      fi
      _git "$gd" checkout -b "$branch" master 2>/dev/null
      if _git "$gd" merge FETCH_HEAD --no-edit 2>/dev/null; then
        _git "$gd" push -u origin "$branch" 2>/dev/null
        _create_pr "$n" "$gd" "$branch" "merge-cross: sync GitHub to Gitee"
      else
        echo -e "    ${R}✗ 合并冲突, 已中止, 请手动处理${N}"
        _git "$gd" merge --abort 2>/dev/null || true
      fi
      _git "$gd" checkout master 2>/dev/null
      _git "$gd" branch -D "$branch" 2>/dev/null || true
      # 恢复暂存的更改
      $gd_stashed && _git "$gd" stash pop 2>/dev/null || true
    fi

    # ── gitee→github: merge Gitee master 到 GitHub ──
    if $DO_L2G; then
      # 在 github 目录 fetch gitee/master → FETCH_HEAD
      _git "$ghd" fetch "$ge_fetch_url" master 2>/dev/null || true
      local ge_ref; ge_ref=$(_git "$ghd" rev-parse FETCH_HEAD 2>/dev/null || echo "")
      if [ -z "$ge_ref" ]; then
        echo -e "  ${R}✗ 无法从 Gitee fetch (检查网络/token)${N}"
        echo ""; continue
      fi
      ts=$(date +%s | tail -c 5)
      branch="cross/ge2gh-${ts}"
      echo -e "  ${C}→ 创建 Gitee→GitHub 同步PR ...${N}"
      # 暂存未提交的本地更改, 避免合并冲突
      local ghd_stashed=false
      if ! _git "$ghd" diff --quiet 2>/dev/null || ! _git "$ghd" diff --cached --quiet 2>/dev/null; then
        _git "$ghd" stash 2>/dev/null && ghd_stashed=true
      fi
      _git "$ghd" checkout -b "$branch" main 2>/dev/null
      if _git "$ghd" merge FETCH_HEAD --no-edit 2>/dev/null; then
        _git "$ghd" push -u origin "$branch" 2>/dev/null
        _create_pr "$n" "$ghd" "$branch" "merge-cross: sync Gitee to GitHub"
      else
        echo -e "    ${R}✗ 合并冲突, 已中止, 请手动处理${N}"
        _git "$ghd" merge --abort 2>/dev/null || true
      fi
      _git "$ghd" checkout main 2>/dev/null
      _git "$ghd" branch -D "$branch" 2>/dev/null || true
      # 恢复暂存的更改
      $ghd_stashed && _git "$ghd" stash pop 2>/dev/null || true
    fi
    echo ""
  done
}

# ═══════════════════════════════════════════════════════════════
#  规范检查 (git-workflow.md §3)
# ═══════════════════════════════════════════════════════════════
# 合法智能体署名
declare -a AGENT_IDS=(wenxin sherlock luban vangogh davinci keane humming sqrl butterfly)
# 合法 type
declare -a COMMIT_TYPES=(feat fix refactor chore docs test ci perf style build)

# 检查提交信息/PR标题是否符合 type(scope): 描述 [#PR号] [智能体ID]
_check_msg_format() {
  local msg="$1" ctx="${2:-commit}"
  # 提取末尾 [署名]
  local agent=""; agent=$(echo "$msg" | grep -oE '\[[a-z0-9]+\]$' | tr -d '[]')
  if [ -z "$agent" ]; then
    echo -e "${R}[规范违规] ${ctx} 缺少智能体署名, 格式: type(scope): 描述 [署名]${N}" >&2
    echo -e "${R}  合法署名: ${AGENT_IDS[*]}${N}" >&2
    return 1
  fi
  local found=false
  for id in "${AGENT_IDS[@]}"; do [ "$id" = "$agent" ] && found=true && break; done
  if ! $found; then
    echo -e "${R}[规范违规] ${ctx} 署名 '${agent}' 不在合法列表: ${AGENT_IDS[*]}${N}" >&2
    return 1
  fi
  # 检查 type 前缀
  local t; t=$(echo "$msg" | grep -oE '^[a-z]+' | head -1)
  local t_found=false
  for ct in "${COMMIT_TYPES[@]}"; do [ "$ct" = "$t" ] && t_found=true && break; done
  if ! $t_found; then
    echo -e "${R}[规范违规] ${ctx} type '${t}' 不合法, 必须为: ${COMMIT_TYPES[*]}${N}" >&2
    return 1
  fi
  return 0
}

# ═══════════════════════════════════════════════════════════════
#  内部: 创建 PR (自动检测目标平台, 用 python3 构造 JSON 避免编码问题)
# ═══════════════════════════════════════════════════════════════
_create_pr() {
  local n="$1" d="$2" b="$3" title="${4:-merge: ${b}}" body="${5:-}"
  load_token; load_gh_token
  local side; case "$d" in *flowlight-ai*) side="github";; *) side="gitee";; esac
  local base; [ "$side" = "gitee" ] && base="master" || base="main"
  if [ "$side" = "gitee" ] && [ -n "$MGR_TOKEN" ]; then
    local payload; payload=$(python3 -c "
import json,sys
print(json.dumps({'title':sys.argv[1],'head':sys.argv[2],'base':sys.argv[3],
  'body':sys.argv[4] or '无描述','access_token':sys.argv[5]}))
" "$title" "$b" "$base" "$body" "$MGR_TOKEN" 2>/dev/null)
    local r; r=$(curl -s -X POST "https://gitee.com/api/v5/repos/${GITEE_ORG}/${n}/pulls" -H "Content-Type: application/json" -d "$payload")
    local u; u=$(echo "$r"|python3 -c "import sys,json; print(json.load(sys.stdin).get('html_url',''))" 2>/dev/null||echo "")
    [ -n "$u" ] && echo -e "    ${G}Gitee PR: $u${N}" || echo -e "    ${R}Gitee PR FAILED: $(echo "$r"|head -c 200)${N}"
  elif [ "$side" = "github" ] && [ -n "$MGR_GH_TOKEN" ]; then
    local payload; payload=$(python3 -c "
import json,sys
print(json.dumps({'title':sys.argv[1],'head':sys.argv[2],'base':sys.argv[3],'body':sys.argv[4] or '无描述'}))
" "$title" "$b" "$base" "$body" 2>/dev/null)
    local r; r=$(curl -s -X POST "https://api.github.com/repos/${GH_ORG}/${n}/pulls" -H "Authorization: token ${MGR_GH_TOKEN}" -H "Content-Type: application/json" -d "$payload")
    local u; u=$(echo "$r"|python3 -c "import sys,json; print(json.load(sys.stdin).get('html_url',''))" 2>/dev/null||echo "")
    [ -n "$u" ] && echo -e "    ${G}GitHub PR: $u${N}" || echo -e "    ${R}GitHub PR FAILED: $(echo "$r"|head -c 200)${N}"
  else
    echo -e "    ${R}无 token, 跳过 PR 创建 (${side})${N}"
  fi
}

# ═══════════════════════════════════════════════════════════════
#  其他命令
# ═══════════════════════════════════════════════════════════════
cmd_list() {
  echo -e "${B}平台感知模式${N}"
  echo -e "  当前平台: ${C}${CURRENT_SIDE}${N} (base=$(_cur_base))"
  echo -e "  Gitee 目录:  ${ROOT_GITEE}"
  echo -e "  GitHub 目录: ${ROOT_GITHUB}"
  echo -e "  本仓库: ${SELF} (作用域: 仅本仓库)"
  echo ""
  echo -e "${B}${#NAMES[@]} projects (当前作用域):${N}"
  for n in "${NAMES[@]}"; do
    local d; d=$(_cur_dir "$n")
    local exists="${G}✓${N}"; [ ! -d "$d/.git" ] && exists="${R}✗${N}"
    printf "  %-14s " "$n"; echo -e "$exists $d"
  done
  echo ""
}

cmd_protect() {
  load_token; [ -z "$MGR_TOKEN" ] && { echo -e "${R}no token${N}"; exit 1; }
  for n in "${NAMES[@]}"; do
    echo -n "  $n: "
    local r; r=$(curl -s -X PUT "https://gitee.com/api/v5/repos/${GITEE_ORG}/${n}/branches/setting/new" -H "Content-Type: application/json" -d "{\"wildcard\":\"master\",\"pusher\":\"none\",\"merger\":\"admin\",\"mode\":\"review\",\"access_token\":\"${MGR_TOKEN}\"}")
    echo "$r"|python3 -c "import sys,json; d=json.load(sys.stdin); print('OK' if d.get('branch_name') else d.get('message','?'))" 2>/dev/null
  done
  echo ""
}

# ═══════════════════════════════════════════════════════════════
#  入口
# ═══════════════════════════════════════════════════════════════
main() {
  case "${1:-}" in
    status|st)     shift; cmd_status "$@" ;;
    sync)          shift; cmd_sync "$@" ;;
    merge-cross)   shift; cmd_merge_cross "$@" ;;
    mirror-setup)  shift; cmd_mirror_setup "$@" ;;
    pr)            shift; cmd_pr "$@" ;;
    commit|ci)     shift; cmd_commit "$@" ;;
    push)          shift; cmd_push "$@" ;;
    pull|pl)       shift; cmd_pull "$@" ;;
    log)           shift; cmd_log "$@" ;;
    diff|df)       shift; cmd_diff "$@" ;;
    branch|br)     cmd_branch ;;
    list|ls)       cmd_list ;;
    protect)       cmd_protect ;;
    *)             usage ;;
  esac
}
main "$@"
