#!/bin/bash
# ============================================================================
# mgr — FlowLight 多仓库管理 (Gitee ⇄ GitHub 双平台/双目录)
#
# 目录模型 (相对定位, 跨平台克隆位置无关):
#   <workspace>/flowlight/<repo>/mgr   → Gitee 端 (origin=gitee.com)
#   <workspace>/flowlight-ai/<repo>    → GitHub端 (origin=github.com)
#
# 作用域 (9 个项目脚本主体一致, 按所在仓库自动决定默认行为):
#   content/mgr   → 默认管理全部 9 个仓库 (总控)
#   其他仓库/mgr  → 默认仅管理本仓库自身
#   --all         → 强制管理全部 9 个仓库
#   --repo NAME   → 仅管理指定仓库 (可叠加使用于任意项目)
#
# 用法:
#   ./mgr [--all|--repo NAME] status | commit | push | pull | clone | log | diff | branch | list
#   ./mgr sync              双平台同步 (自动创建临时分支 → push → 创建 PR, 禁止直接push主干)
#   ./mgr push --pr         push 当前分支并自动创建 PR
#   ./mgr pr "标题"         双平台创建 PR (当前分支 → Gitee master / GitHub main)
#   ./mgr mirror-setup      一键配置双端互指 mirror 远程
#   ./mgr protect           设置 master 分支保护 (仅 Gitee)
#
# 分支模型 (强制): 仅主干开发 — Gitee=master / GitHub=main, 一律经 PR 合入;
#   禁止直接 push 到 master/main (cmd_push 会拒绝并提示用 PR);
#   sync 命令自动创建临时 sync/* 分支, push 后创建 PR, 不触碰主干。
# ============================================================================
set -e
_git() { local d="$1"; shift; (cd "$d" && git "$@"); }

# ── 路径 (相对定位) ────────────────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_GITEE="$(cd "$SCRIPT_DIR/.." && pwd)"
ROOT_GITHUB="$(cd "$(dirname "$ROOT_GITEE")/flowlight-ai" 2>/dev/null && pwd || echo "$(dirname "$ROOT_GITEE")/flowlight-ai")"
GITEE_ORG="flowlight-ai"; GH_ORG="flowlight-ai"
SELF="$(basename "$SCRIPT_DIR")"

# ── 注册: 名称 gitee子路径 github子路径 ─────────────────────────
declare -a NAMES=()
declare -A GPATH=()    # gitee 本地路径
declare -A GH_PATH=()  # github 本地路径
declare -A GURL=()     # gitee 远程 URL
declare -A GH_URL=()   # github 远程 URL

reg() { local n="$1" gr="$2" ghr="$3"; NAMES+=("$n")
  GPATH["$n"]="$ROOT_GITEE/$gr"; GH_PATH["$n"]="$ROOT_GITHUB/$ghr"
  GURL["$n"]="https://gitee.com/${GITEE_ORG}/${n}.git"
  GH_URL["$n"]="https://github.com/${GH_ORG}/${n}.git"; }

reg "content"      "content"      "content"
reg "openroute"    "openroute"    "openroute"
reg "flowforge"    "flowforge"    "flowforge"
reg "stockforge"   "stockforge"   "stockforge"
reg "contentforge" "contentforge" "contentforge"
reg "devforge"     "devforge"     "devforge"
reg "novelforge"   "novelforge"   "novelforge"
reg "mallforge"    "mallforge"    "mallforge"
reg "opensieve"    "opensieve"    "opensieve"

# ── 作用域解析: content 默认全部, 其他仓库默认自身 ───────────────
SCOPE="default"
SCOPE_REPO=""
while [ $# -gt 0 ]; do
  case "$1" in
    --all)  SCOPE="all"; shift ;;
    --repo) SCOPE="repo"; SCOPE_REPO="${2:-}"; shift 2 ;;
    *) break ;;
  esac
done
if [ "$SCOPE" = "default" ]; then
  if [ "$SELF" = "content" ]; then SCOPE="all"; else SCOPE="self"; fi
fi
case "$SCOPE" in
  all)  : ;;  # NAMES 保持全部 9 个
  self) NAMES=("$SELF") ;;
  repo)
    if [[ ! " ${NAMES[*]} " =~ " ${SCOPE_REPO} " ]]; then
      echo "错误: 未知仓库 '$SCOPE_REPO' (可选: ${NAMES[*]})" >&2; exit 1
    fi
    NAMES=("$SCOPE_REPO") ;;
esac

# ── 颜色 ────────────────────────────────────────────────────────
R='\033[0;31m'; G='\033[0;32m'; Y='\033[1;33m'; C='\033[0;36m'; B='\033[1m'; N='\033[0m'

# ── Token (本仓库 .mgr-token → 工作区根 .mgr-token → 环境变量) ──
load_token() {
  local f="$SCRIPT_DIR/.mgr-token"
  [ ! -f "$f" ] && f="$ROOT_GITEE/.mgr-token"
  [ -f "$f" ] && MGR_TOKEN="$(cat "$f"|tr -d '[:space:]')" || MGR_TOKEN="${GITEE_TOKEN:-}"; }
load_gh_token() { MGR_GH_TOKEN="${GITHUB_TOKEN:-}"; [ -z "$MGR_GH_TOKEN" ] && [ -f "$HOME/.github-token" ] && MGR_GH_TOKEN="$(cat "$HOME/.github-token"|tr -d '[:space:]')"; }

# ── 辅助 ────────────────────────────────────────────────────────
usage() { sed -n '2,24p' "$0"; exit 0; }

# ──────── 命令 ──────────────────────────────────────────────────

cmd_status() {
  for n in "${NAMES[@]}"; do
    for side in gitee github; do
      local d; [ "$side" = "gitee" ] && d="${GPATH[$n]}" || d="${GH_PATH[$n]}"
      [ ! -d "$d/.git" ] && continue
      local out; out=$(_git "$d" status --short 2>&1) || true
      [ -n "$out" ] && { echo -e "${B}${Y}-- ${n} (${side}) --${N}"; echo "$out"; }
    done
  done
  echo -e "${B}分支 & 同步状态:${N}"
  for n in "${NAMES[@]}"; do
    for side in gitee github; do
      local d; [ "$side" = "gitee" ] && d="${GPATH[$n]}" || d="${GH_PATH[$n]}"
      [ ! -d "$d/.git" ] && continue
      local b; b=$(_git "$d" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
      _git "$d" remote update origin &>/dev/null || true
      local a=$(_git "$d" rev-list --count "origin/${b}..${b}" 2>/dev/null || echo "?")
      local be=$(_git "$d" rev-list --count "${b}..origin/${b}" 2>/dev/null || echo "?")
      printf "  %-14s ${C}%s${N} [${Y}%s${N}] ${G}↑%s${N} ${R}↓%s${N}\n" "$n" "$side" "$b" "$a" "$be"
    done
  done
  echo ""
}

# ── 容错状态文件 ────────────────────────────────────────────────
SYNC_STATE="$SCRIPT_DIR/.mgr-sync-state"

_sync_fail() { echo "$1" >> "$SYNC_STATE"; }
_sync_report() {
  echo -e "\n${B}═══ Sync 报告 ═══${N}"
  local ok=0 fail=0
  if [ -f "$SYNC_STATE" ]; then
    while IFS= read -r line; do
      case "$line" in
        OK:*) ok=$((ok+1)); echo -e "  ${G}✓${N} ${line#OK:}" ;;
        FAIL:*) fail=$((fail+1)); echo -e "  ${R}✗${N} ${line#FAIL:}";;
      esac
    done < "$SYNC_STATE"
  fi
  echo -e "  ${G}${ok} 成功${N}  ${R}${fail} 失败${N}"
  if [ $fail -gt 0 ]; then
    echo -e "  ${Y}运行: ./mgr sync --retry 重试失败项${N}"
  fi
  rm -f "$SYNC_STATE"
}

cmd_sync() {
  # ⚠ sync 已废弃直接 push 行为, 改为强制走 PR (主干保护)
  # 用法: ./mgr sync [--retry]
  # 行为: 对有领先提交的仓库, 在非主干分支上创建临时分支, push 并创建 PR
  local RETRY=false
  [ "${1:-}" = "--retry" ] && { RETRY=true; shift; }

  # 如果 --retry，从状态文件读取失败项
  local -A FAILED=()
  if $RETRY && [ -f "$SYNC_STATE" ]; then
    while IFS= read -r line; do
      case "$line" in FAIL:*) FAILED["${line#FAIL:}"]=1;; esac
    done < "$SYNC_STATE"
    rm -f "$SYNC_STATE"
  fi

  >"$SYNC_STATE"  # 清空状态文件
  local TMPERR; TMPERR="$(mktemp)"
  load_token; load_gh_token

  for n in "${NAMES[@]}"; do
    [ -n "${1:-}" -a "$n" != "${1:-}" ] && continue

    for side in gitee github; do
      local d; [ "$side" = "gitee" ] && d="${GPATH[$n]}" || d="${GH_PATH[$n]}"
      [ -d "$d/.git" ] || continue

      local b; b=$(_git "$d" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
      local base; [ "$side" = "gitee" ] && base="master" || base="main"
      local dirty; dirty=$(_git "$d" status --short 2>/dev/null | wc -l)
      local ahead; ahead=$(_git "$d" rev-list --count "origin/${base}..${b}" 2>/dev/null || echo "0")

      local sync_key="${side^}:$n:${b}"
      $RETRY && [ -z "${FAILED[$sync_key]}" ] && continue

      echo -e "${B}══ ${n} / ${side^} [${b}]${N}"

      # 无领先提交, 跳过
      if [ "$ahead" = "0" ] && [ "$dirty" = "0" ]; then
        echo -e "  ${G}✓ 已同步${N}"; _sync_fail "OK:$sync_key"; continue
      fi

      # 在主干分支: 创建临时 sync 分支, 避免直接 push 主干
      local sync_branch="${b}"
      local need_branch=false
      if [ "$b" = "$base" ]; then
        sync_branch="sync/${base}-$(date +%s | tail -c 5)"
        _git "$d" checkout -b "$sync_branch" 2>/dev/null || true
        need_branch=true
        echo -e "  ${Y}主干分支, 创建临时分支: ${sync_branch}${N}"
      fi

      # dirty 文件先 commit
      if [ "$dirty" -gt 0 ]; then
        _git "$d" add -A
        _git "$d" commit -m "sync: 双平台同步提交 [humming]" 2>/dev/null || true
      fi

      # Push 临时分支
      echo -n "  ${side} push ${sync_branch} ... "
      if _git "$d" push -u origin "$sync_branch" 2>"$TMPERR"; then
        echo -e "${G}OK${N}"
        # 创建 PR
        _create_pr "$n" "$d" "$sync_branch"
        _sync_fail "OK:$sync_key"
      else
        echo -e "${R}FAIL: $(head -2 "$TMPERR"|tr '\n' ' '|cut -c1-80)${N}"
        _sync_fail "FAIL:$sync_key"
      fi

      # 回到主干分支
      $need_branch && _git "$d" checkout "$base" 2>/dev/null && _git "$d" branch -D "$sync_branch" 2>/dev/null || true
    done
    echo ""
  done
  _sync_report
  rm -f "$TMPERR"
}

cmd_mirror_setup() {
  for n in "${NAMES[@]}"; do
    echo -e "${B}${n}:${N}"
    local gd="${GPATH[$n]}" ghd="${GH_PATH[$n]}"
    if [ -d "$gd/.git" ]; then
      _git "$gd" remote get-url github &>/dev/null && _git "$gd" remote set-url github "${GH_URL[$n]}" || _git "$gd" remote add github "${GH_URL[$n]}" 2>/dev/null
      echo "  gitee dir: github mirror ready"
    fi
    if [ -d "$ghd/.git" ]; then
      _git "$ghd" remote get-url gitee &>/dev/null && _git "$ghd" remote set-url gitee "${GURL[$n]}" || _git "$ghd" remote add gitee "${GURL[$n]}" 2>/dev/null
      echo "  github dir: gitee mirror ready"
    fi
  done
  echo -e "\n${B}现在运行 ${C}./mgr sync${N}${B} 双向推送${N}"
}

cmd_pr() {
  local title="${*:-feat: merge to trunk}"; load_token; load_gh_token
  for n in "${NAMES[@]}"; do
    local gd="${GPATH[$n]}"; [ ! -d "$gd/.git" ] && gd="${GH_PATH[$n]}"
    [ ! -d "$gd/.git" ] && continue
    local b; b=$(_git "$gd" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")
    echo -e "${B}═══ ${n} PR (head=${b}) ═══${N}"
    # 判断当前目录属于哪个平台
    local side; case "$gd" in *flowlight-ai*) side="github";; *) side="gitee";; esac
    local base; [ "$side" = "gitee" ] && base="master" || base="main"

    # 如果在主干分支, 警告 (主干无法直接创建 PR, head==base)
    if [ "$b" = "$base" ]; then
      echo -e "  ${Y}当前在主干 ${b} 上, head==base 无法创建PR${N}"
      echo -e "  ${Y}请先切到非主干分支再创建PR: git checkout -b feat/xxx${N}"
      continue
    fi

    _create_pr "$n" "$gd" "$b" "$title"
    echo ""
  done
}

# ── 内部: 创建 PR (支持自定义标题) ─────────────────────────────
_create_pr() {
  local n="$1" d="$2" b="$3" title="${4:-merge: ${b}}"
  load_token; load_gh_token
  local side; case "$d" in *flowlight-ai*) side="github";; *) side="gitee";; esac
  local base; [ "$side" = "gitee" ] && base="master" || base="main"
  if [ "$side" = "gitee" ] && [ -n "$MGR_TOKEN" ]; then
    local r; r=$(curl -s -X POST "https://gitee.com/api/v5/repos/${GITEE_ORG}/${n}/pulls" -H "Content-Type: application/json" -d "{\"title\":\"${title}\",\"head\":\"${b}\",\"base\":\"${base}\",\"access_token\":\"${MGR_TOKEN}\"}")
    local u; u=$(echo "$r"|python3 -c "import sys,json; print(json.load(sys.stdin).get('html_url',''))" 2>/dev/null||echo "")
    [ -n "$u" ] && echo -e "  ${G}Gitee PR: $u${N}" || echo -e "  ${R}Gitee PR FAILED${N}"
  elif [ "$side" = "github" ] && [ -n "$MGR_GH_TOKEN" ]; then
    local r; r=$(curl -s -X POST "https://api.github.com/repos/${GH_ORG}/${n}/pulls" -H "Authorization: token ${MGR_GH_TOKEN}" -H "Content-Type: application/json" -d "{\"title\":\"${title}\",\"head\":\"${b}\",\"base\":\"${base}\"}")
    local u; u=$(echo "$r"|python3 -c "import sys,json; print(json.load(sys.stdin).get('html_url',''))" 2>/dev/null||echo "")
    [ -n "$u" ] && echo -e "  ${G}GitHub PR: $u${N}" || echo -e "  ${R}GitHub PR FAILED${N}"
  fi
}

cmd_commit() { local m="$*"; [ -z "$m" ] && { echo -e "${R}缺少msg${N}"; exit 1; }; for n in "${NAMES[@]}"; do for d in "${GPATH[$n]}" "${GH_PATH[$n]}"; do [ -d "$d/.git" ] || continue; _git "$d" add -A; _git "$d" diff --cached --quiet && continue; echo -e "${B}${n}${N}"; _git "$d" commit -m "$m" 2>&1|tail -1; done; done; echo ""; }
cmd_push()   {
  local TMP; TMP="$(mktemp)"
  local DO_PR=false
  [ "${1:-}" = "--pr" ] && { DO_PR=true; shift; }
  for n in "${NAMES[@]}"; do
    [ -n "${1:-}" -a "$n" != "${1:-}" ] && continue
    for d in "${GPATH[$n]}" "${GH_PATH[$n]}"; do
      [ -d "$d/.git" ] || continue
      local b=$(_git "$d" rev-parse --abbrev-ref HEAD)
      local side; case "$d" in *flowlight-ai*) side="github";; *) side="gitee";; esac
      # 主干分支保护: 禁止直接 push 到 master/main, 必须走 PR
      if [ "$b" = "master" -o "$b" = "main" ]; then
        echo -e "  ${Y}${n} (${side}): 在主干 ${b} 上, 禁止直接push, 请用 ./mgr pr 创建PR${N}"
        continue
      fi
      echo -ne "  ${B}${n} (${side}) → origin/${b} ... ${N}"
      if _git "$d" push -u origin "$b" 2>"$TMP"; then
        echo -e "${G}OK${N}"
        # --pr 模式: push 后自动创建 PR
        $DO_PR && _create_pr "$n" "$d" "$b"
      else
        echo -e "${R}FAIL${N}"; sed 's/^/    /' "$TMP" | head -6
      fi
    done
  done
  rm -f "$TMP"; echo ""
}

cmd_pull()   {
  local TMP; TMP="$(mktemp)"
  for n in "${NAMES[@]}"; do
    [ -n "${1:-}" -a "$n" != "${1:-}" ] && continue
    for side in gitee github; do
      local d; [ "$side" = "gitee" ] && d="${GPATH[$n]}" || d="${GH_PATH[$n]}"
      [ -d "$d/.git" ] || continue
      local b; b=$(_git "$d" branch --show-current 2>/dev/null || echo "?")
      echo -e "${B}══ ${n} (${side}) [${b}]${N}"
      if ! _git "$d" fetch origin 2>"$TMP"; then
        echo -e "  ${R}✗ fetch origin 失败: $(head -2 "$TMP"|tr '\n' ' ')${N}"; continue
      fi
      # 远端无同名分支 (如 master 已改名 main): 自动对齐远端默认分支
      if ! _git "$d" show-ref --verify --quiet "refs/remotes/origin/${b}"; then
        _git "$d" remote set-head origin -a &>/dev/null || true
        local rb; rb=$(_git "$d" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@')
        if [ -n "$rb" ] && [ "$rb" != "$b" ]; then
          if [ "$(_git "$d" rev-parse "${b}^{tree}" 2>/dev/null)" = "$(_git "$d" rev-parse "origin/${rb}^{tree}" 2>/dev/null)" ]; then
            echo -e "  ${Y}⚠ 远端无 origin/${b} (已改名 ${rb}), 本地内容已等价 → 切换到 ${rb}${N}"
            _git "$d" checkout -q -B "$rb" "origin/${rb}" && _git "$d" branch -q -D "$b" 2>/dev/null || true
            b="$rb"
          else
            echo -e "  ${R}✗ 远端无 origin/${b} (默认分支=${rb:-?}), 且本地内容与 origin/${rb} 不一致, 请人工处理${N}"; continue
          fi
        else
          echo -e "  ${R}✗ 远端无 origin/${b}, 也无法确定默认分支${N}"; continue
        fi
      fi
      local a be
      a=$(_git "$d" rev-list --count "origin/${b}..${b}" 2>/dev/null || echo 0)
      be=$(_git "$d" rev-list --count "${b}..origin/${b}" 2>/dev/null || echo 0)
      if [ "$a" = 0 ] && [ "$be" = 0 ]; then echo -e "  ${G}✓ 已同步${N}"; continue; fi
      if [ "$a" != 0 ] && [ "$be" = 0 ]; then
        echo -e "  ${Y}↑ 本地领先 ${a} 个提交 (远端未变化, 待 PR 合入或待 push), 无需拉取${N}"; continue
      fi
      if [ "$a" = 0 ]; then
        if _git "$d" merge --ff-only -q "origin/${b}" 2>"$TMP"; then
          echo -e "  ${G}✓ 已快进 ${be} 个提交${N}"
        else
          echo -e "  ${R}✗ 快进失败: $(head -1 "$TMP")${N}"
        fi
        continue
      fi
      # 分叉: 展示双方独有提交, 尝试 rebase, 失败则回滚并给出指引
      echo -e "  ${Y}⚠ 分叉: 本地领先 ${a} / 远端领先 ${be}${N}"
      echo "  本地独有:"; _git "$d" log --oneline "origin/${b}..${b}" | head -5 | sed 's/^/    /'
      echo "  远端独有:"; _git "$d" log --oneline "${b}..origin/${b}" | head -5 | sed 's/^/    /'
      if _git "$d" rebase -q "origin/${b}" 2>"$TMP"; then
        echo -e "  ${G}✓ rebase 成功, 本地提交已重放到远端之上${N}"
      else
        _git "$d" rebase --abort 2>/dev/null || true
        echo -e "  ${R}✗ rebase 失败已还原: $(head -1 "$TMP")${N}"
        echo -e "  ${Y}指引: 若本地提交已以新哈希合入远端(PR合入), 确认树内容一致后可执行: git reset --hard origin/${b}${N}"
      fi
    done
  done
  rm -f "$TMP"; echo ""
}
cmd_log()    { local L=5; [ -n "${1:-}" ] && [[ "${1:-}" =~ ^[0-9]+$ ]] && { L="$1"; shift; }; for n in "${NAMES[@]}"; do for d in "${GPATH[$n]}" "${GH_PATH[$n]}"; do [ -d "$d/.git" ] || continue; echo -e "${B}${n}${N}"; _git "$d" log --oneline -"$L"; done; done; echo ""; }
cmd_diff()   { for n in "${NAMES[@]}"; do for d in "${GPATH[$n]}" "${GH_PATH[$n]}"; do [ -d "$d/.git" ] || continue; local out; out=$(_git "$d" diff --stat 2>&1); [ -n "$out" ] && { echo -e "${B}${n}${N}"; echo "$out"; }; done; done; echo ""; }
cmd_branch() { for n in "${NAMES[@]}"; do for d in "${GPATH[$n]}" "${GH_PATH[$n]}"; do [ -d "$d/.git" ] || continue; printf "  %-14s %s\n" "$n" "$(_git "$d" branch --show-current)"; done; done; echo ""; }
cmd_list()   { echo -e "${B}双目录模型:${N}\n  Gitee:  ${ROOT_GITEE}\n  GitHub: ${ROOT_GITHUB}\n  本仓库: ${SELF} (默认作用域: $([ "$SELF" = content ] && echo "全部 9 仓库" || echo "仅本仓库"))\n\n${B}${#NAMES[@]} projects (当前作用域):${N}"; for n in "${NAMES[@]}"; do printf "  %-14s gitee=%s github=%s\n" "$n" "${GURL[$n]}" "${GH_URL[$n]}"; done; echo ""; }
cmd_protect() { load_token; [ -z "$MGR_TOKEN" ] && { echo -e "${R}no token${N}"; exit 1; }; for n in "${NAMES[@]}"; do echo -n "  $n: "; r=$(curl -s -X PUT "https://gitee.com/api/v5/repos/${GITEE_ORG}/${n}/branches/setting/new" -H "Content-Type: application/json" -d "{\"wildcard\":\"master\",\"pusher\":\"none\",\"merger\":\"admin\",\"mode\":\"review\",\"access_token\":\"${MGR_TOKEN}\"}"); echo "$r"|python3 -c "import sys,json; d=json.load(sys.stdin); print('OK' if d.get('branch_name') else d.get('message','?'))" 2>/dev/null; done; echo ""; }

main() {
  case "${1:-}" in
    status|st)    cmd_status ;;
    sync)         shift; cmd_sync "$@" ;;
    sync:--retry)  shift; cmd_sync "--retry" "$@" ;;  # 额外的入口风格
    mirror-setup) cmd_mirror_setup ;;
    pr)           shift; cmd_pr "$@" ;;
    commit|ci)    shift; cmd_commit "$@" ;;
    push)         shift; cmd_push "${1:-}" ;;
    pull|pl)      shift; cmd_pull "${1:-}" ;;
    log)          shift; cmd_log "$@" ;;
    diff|df)      shift; cmd_diff "${1:-}" ;;
    branch|br)    cmd_branch ;;
    list|ls)      cmd_list ;;
    protect)      cmd_protect ;;
    *) usage ;;
  esac
}
main "$@"
